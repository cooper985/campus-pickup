page { background: #f3f6f4; color: #193b30; }
.pickup { padding: 44rpx 32rpx 64rpx; }
.eyebrow { color: #526e61; font-size: 24rpx; margin-bottom: 16rpx; }
.heading { font-size: 42rpx; line-height: 1.4; font-weight: 700; }
.intro { font-size: 28rpx; color: #52665d; line-height: 1.7; margin: 18rpx 0 28rpx; }
.notice { background: #fff4d9; color: #72551a; border-radius: 16rpx; padding: 24rpx; font-size: 25rpx; line-height: 1.6; }
.card { background: #fff; border-radius: 24rpx; padding: 28rpx; margin: 28rpx 0; }
.section-title { font-size: 30rpx; font-weight: 600; margin-bottom: 24rpx; }
.placeholder { padding: 60rpx 12rpx; text-align: center; border: 2rpx dashed #c7d7ce; border-radius: 16rpx; margin-bottom: 24rpx; font-size: 30rpx; }
.hint { display: block; color: #62756b; font-size: 24rpx; line-height: 1.6; margin-top: 12rpx; }
.preview { width: 100%; height: 420rpx; background: #eef3f0; border-radius: 16rpx; margin-bottom: 20rpx; }
button { font-size: 28rpx; border-radius: 16rpx; }
.secondary { background: #e9f2ec; color: #215b41; }
.primary { background: #216b48; color: #fff; }
.primary[disabled], .secondary[disabled] { background: #dfe6e1; color: #69796e; }
.error { color: #9c3029; background: #fff0ed; padding: 24rpx; margin-top: 24rpx; border-radius: 16rpx; }
.image-result { padding: 20rpx 24rpx; margin: 16rpx 0; }
.result-summary { display: flex; justify-content: space-between; gap: 16rpx; font-size: 26rpx; }
.result-status { color: #526e61; }
.footer { text-align: center; font-size: 23rpx; line-height: 1.7; color: #62756b; margin-top: 36rpx; }
.thumbnails { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 24rpx; }
.thumbnail { width: 190rpx; height: 220rpx; background: #eef3f0; border-radius: 12rpx; }
.board-title { margin-top: 40rpx; font-size: 34rpx; }
.parcel { padding: 24rpx 0; border-top: 1rpx solid #edf1ee; }
.pickup-code { font-size: 42rpx; font-weight: 700; }
.taken .pickup-code { text-decoration: line-through; color: #83938b; }
.actions { display: flex; gap: 16rpx; margin-top: 20rpx; }
.actions button { margin: 0; }
input { border: 1rpx solid #c7d7ce; border-radius: 12rpx; padding: 20rpx; margin-bottom: 20rpx; font-size: 28rpx; }
.primary { margin-top: 12rpx; }

.swipe-shell { position: relative; overflow: hidden; border-top: 1rpx solid #edf1ee; }
.swipe-content { position: relative; background: #fff; border-top: 0; transition: transform 180ms ease; }
.swipe-open { transform: translateX(-80px); }
.delete-button { position: absolute; right: 0; top: 50%; transform: translateY(-50%); width: 64px; min-width: 0; max-width: 64px; box-sizing: border-box; height: 88rpx; padding: 0; margin: 0; border-radius: 12rpx; background: #c43d35; color: #fff; z-index: 2; display: block; line-height: 88rpx; text-align: center; }
.delete-label { display: block; color: #fff; font-size: 28rpx; font-weight: 600; line-height: 88rpx; }
.undo-bar { position: fixed; z-index: 10; bottom: 32rpx; bottom: calc(32rpx + env(safe-area-inset-bottom)); left: 32rpx; right: 32rpx; padding: 20rpx 24rpx; background: #193b30; color: #fff; border-radius: 16rpx; display: flex; align-items: center; justify-content: space-between; font-size: 26rpx; }
.undo-action { margin: 0; color: #215b41; }
