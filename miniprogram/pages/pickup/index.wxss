.pickup { background: #f4f6f5; color: #203a30; font-size: 28rpx; min-height: 100vh; box-sizing: border-box; padding: 32rpx 28rpx calc(160rpx + env(safe-area-inset-bottom)); }
.heading { font-size: 40rpx; line-height: 1.4; font-weight: 700; }
.count { font-size: 48rpx; color: #216b48; }
.eyebrow { font-size: 23rpx; color: #738279; margin-bottom: 8rpx; }
.page-header { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 32rpx; }
.hint, .subtitle { color: #748078; font-size: 24rpx; line-height: 1.6; margin-top: 8rpx; }
.subtitle { margin-bottom: 32rpx; }
.ui-button { width: auto; font-size: 28rpx; border-radius: 14rpx; font-weight: 500; line-height: 2.8; }
.ui-button::after { border: 0; }
.primary { background: #216b48; color: white; }
.secondary { background: #edf3ef; color: #216b48; }
.ui-button.ui-disabled { background: #e2e8e4; color: #879189; }
.import-entry { line-height: 76rpx; margin: 0; padding: 0 22rpx; font-size: 25rpx; flex-shrink: 0; }
.card { background: #fff; border-radius: 20rpx; margin-bottom: 20rpx; overflow: hidden; }
.station-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; padding: 24rpx; }
.station-name { font-size: 28rpx; font-weight: 600; line-height: 1.6; overflow-wrap: anywhere; word-break: break-all; flex: 1; min-width: 0; }
.station-count { flex-shrink: 0; color: #748078; font-size: 24rpx; line-height: 1.8; }
.review { color: #966823; }
.parcel-row { display: flex; align-items: center; gap: 16rpx; padding: 22rpx 24rpx; border-top: 1rpx solid #eef1ef; }
.parcel-main { flex: 1; min-width: 0; }
.pickup-code { display: block; font-size: 40rpx; font-weight: 700; line-height: 1.35; letter-spacing: 1rpx; overflow-wrap: anywhere; word-break: break-all; font-variant-numeric: tabular-nums; }
.record-meta { margin-top: 6rpx; font-size: 23rpx; color: #748078; }
.text-action { display: inline-block; padding: 8rpx 12rpx 8rpx 0; color: #397659; }
.parcel-row .ui-button { flex-shrink: 0; margin: 0; padding: 0 18rpx; font-size: 25rpx; line-height: 72rpx; }
.take-button { color: #216b48; background: #edf3ef; }
.empty { padding: 88rpx 20rpx; text-align: center; }
.empty-symbol { margin: 0 auto 28rpx; width: 88rpx; height: 88rpx; line-height: 88rpx; font-size: 44rpx; color: #548368; background: #e6eee9; border-radius: 50%; }
.section-title { font-size: 32rpx; font-weight: 600; margin-bottom: 12rpx; }
.empty .ui-button { margin: 32rpx auto 0; width: 320rpx; }
.choose-button { margin-top: 24rpx; line-height: 96rpx; }
.centered { text-align: center; font-size: 22rpx; margin: 16rpx 0 28rpx; }
.section-heading { font-weight: 600; font-size: 30rpx; margin: 32rpx 0 20rpx; }
.small-heading { font-size: 26rpx; color: #65746b; }
.inline { margin-left: 16rpx; font-weight: 400; }
.progress-line { display: flex; align-items: center; justify-content: space-between; color: #397659; font-size: 26rpx; }
.text-button { color: #65746b; background: transparent; margin: 0; padding: 0 12rpx; }
.image-result { display: flex; align-items: center; padding: 20rpx; gap: 20rpx; }
.result-thumbnail { width: 76rpx; height: 100rpx; border-radius: 8rpx; background: #eef2ef; flex-shrink: 0; }
.result-copy { flex: 1; min-width: 0; }
.result-label { font-size: 23rpx; color: #869087; margin-bottom: 6rpx; }
.result-status { font-size: 26rpx; color: #627068; line-height: 1.5; }
.success { color: #216b48; font-weight: 600; }
.image-result .ui-button { flex-shrink: 0; margin: 0; }
.error, .notice { padding: 20rpx; margin: 16rpx 0; border-radius: 12rpx; font-size: 25rpx; line-height: 1.6; }
.error { background: #fff0ed; color: #a24436; }
.notice { background: #faf0df; color: #8b692e; }
.privacy { font-size: 22rpx; line-height: 1.8; color: #869087; padding: 32rpx 12rpx; }
.swipe-shell { position: relative; overflow: hidden; border-bottom: 1rpx solid #eef1ef; }
.swipe-content { position: relative; z-index: 1; background: #fff; padding: 24rpx; transition: transform 180ms ease; }
.swipe-open { transform: translateX(-80px); }
.delete-label { position: absolute; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 28rpx; font-weight: 600; line-height: 1.5; }
.delete-button { position: absolute; right: 0; top: 0; bottom: 0; width: 80px; height: 100%; padding: 0; margin: 0; border-radius: 0; background: #c9453d; color: white; display: flex; align-items: center; justify-content: center; font-size: 28rpx; }
.history-top, .history-bottom { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.history-top .pickup-code { flex: 1; min-width: 0; font-size: 36rpx; }
.taken-badge { flex-shrink: 0; font-size: 22rpx; color: #738479; }
.history-station { font-size: 25rpx; color: #65746b; margin: 12rpx 0; word-break: break-all; line-height: 1.6; }
.history-bottom .ui-button { margin: 0; font-size: 24rpx; }
.bottom-nav { position: fixed; bottom: 0; left: 0; right: 0; z-index: 10; display: flex; background: #fff; border-top: 1rpx solid #e7ece8; padding: 8rpx 16rpx calc(8rpx + env(safe-area-inset-bottom)); }
.nav-item { flex: 1; margin: 0; padding: 6rpx 0; border-radius: 12rpx; color: #88938c; font-size: 23rpx; line-height: 1.5; background: transparent; display: flex; flex-direction: column; align-items: center; }
.nav-symbol { font-size: 36rpx; line-height: 1.2; margin-bottom: 4rpx; }
.nav-active { color: #216b48; background: #eff5f1; font-weight: 600; }
.undo-bar { position: fixed; z-index: 12; bottom: calc(128rpx + env(safe-area-inset-bottom)); left: 28rpx; right: 28rpx; padding: 16rpx 24rpx; background: #203a30; color: #fff; border-radius: 14rpx; display: flex; align-items: center; justify-content: space-between; font-size: 25rpx; }
.undo-action { margin: 0; color: #c9f1d6; background: transparent; }
.modal-mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 20; background: rgba(20,40,30,.32); display: flex; align-items: center; justify-content: center; padding: 28rpx; }
.edit-sheet { width: 100%; max-height: 80vh; overflow-y: auto; background: #fff; border-radius: 24rpx; padding: 32rpx; box-sizing: border-box; }
.field-label { display: block; font-size: 24rpx; color: #65746b; margin: 24rpx 0 12rpx; }
.field-input, .station-input { width: 100%; box-sizing: border-box; background: #f3f6f4; border-radius: 12rpx; padding: 20rpx; font-size: 28rpx; min-height: 80rpx; line-height: 1.5; }
.actions { display: flex; gap: 20rpx; margin-top: 32rpx; }
.actions .ui-button { flex: 1; margin: 0; }
@media (prefers-reduced-motion: reduce) { .swipe-content { transition: none; } }
