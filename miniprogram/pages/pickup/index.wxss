/* Warm Paper: one shared vocabulary for all five product views. */
.pickup { background: var(--page); color: var(--text); font-size: 28rpx; min-height: 100vh; box-sizing: border-box; padding: 24rpx 32rpx calc(110px + env(safe-area-inset-bottom)); }
.page-header { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin: 8rpx 0 28rpx; }
.heading { font-size: 36rpx; line-height: 1.4; font-weight: 600; }
.page-panel > .heading { margin: 8rpx 0 28rpx; }
.count { font-size: 44rpx; font-weight: 700; margin-left: 6rpx; }
.hint, .subtitle { color: var(--secondary); font-size: 24rpx; line-height: 1.6; margin-top: 8rpx; overflow-wrap: anywhere; }
.subtitle { margin-bottom: 20rpx; }
.ui-button { display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: auto; min-height: 44px; padding: 0 24rpx; font-size: 28rpx; border-radius: var(--button-radius); font-weight: 500; line-height: 44px; transition: transform var(--press-duration) ease-out, opacity var(--press-duration) ease-out; }
.ui-button::after { border: 0; }
.primary { background: var(--primary); color: var(--card); }
.secondary { background: var(--card); color: var(--text); border: 1rpx solid var(--line); }
.ui-button.ui-disabled { background: var(--line); color: var(--secondary); opacity: .7; }
.text-button { color: var(--secondary); background: transparent; margin: 0; padding: 0 12rpx; }
.ui-button.button-pressed, .delete-button.button-pressed { transform: scale(.975); opacity: .8; transition-duration: 100ms; }
.card { background: var(--card); border: 1rpx solid var(--line); border-radius: var(--radius); margin-bottom: 24rpx; overflow: hidden; }
.station-header { display: flex; align-items: center; gap: 12rpx; padding: 20rpx 24rpx; min-height: 44px; box-sizing: border-box; }
.station-name { flex: 1; min-width: 0; font-size: 28rpx; font-weight: 600; line-height: 1.5; overflow-wrap: anywhere; }
.station-mark { width: 12rpx; height: 12rpx; background: var(--accent); border-radius: 50%; flex-shrink: 0; }
.station-count { flex-shrink: 0; color: var(--secondary); font-size: 24rpx; }
.review { color: var(--accent-ink); }
.parcel-row { display: flex; align-items: center; gap: 16rpx; padding: 24rpx; border-top: 1rpx solid var(--line); }
.parcel-main { flex: 1; min-width: 0; }
.code-scroll { display: block; width: 100%; min-width: 0; white-space: nowrap; }
.pickup-code, .review-code { display: inline-block; white-space: nowrap; color: var(--text); font-family: Menlo, Consolas, monospace; font-variant-numeric: tabular-nums; font-weight: 700; letter-spacing: -.5rpx; line-height: 1.45; }
.pickup-code { font-size: 52rpx; }
.copy-code { min-height: 44px; line-height: 44px; }
.record-meta { display: flex; align-items: center; flex-wrap: wrap; color: var(--secondary); font-size: 24rpx; }
.text-action { display: inline-block; min-height: 44px; line-height: 44px; padding: 0 16rpx 0 0; color: var(--secondary); }
.text-action.button-pressed { opacity: .65; }
.parcel-row .ui-button { flex-shrink: 0; margin: 0; padding: 0 18rpx; font-size: 24rpx; }
.ui-button.take-button { display: inline-flex; flex: 0 0 auto; align-self: center; width: auto; min-width: 68px; height: 44px; min-height: 44px; padding: 0 24rpx; border: 0; border-radius: 999rpx; line-height: 1.4; white-space: nowrap; color: var(--accent-ink); background: var(--surface); }
.ui-button.take-button.ui-disabled { background: var(--line); color: var(--secondary); }
.empty { padding: 100rpx 12rpx; text-align: center; color: var(--secondary); line-height: 1.6; }
.section-title, .section-heading { font-size: 30rpx; font-weight: 600; line-height: 1.5; }
.section-title { margin-bottom: 16rpx; overflow-wrap: anywhere; }
.section-heading { margin: 24rpx 0 16rpx; }
.small-heading { font-size: 26rpx; color: var(--secondary); }
.inline { margin-left: 16rpx; font-weight: 400; }
.batch-row { display: flex; justify-content: flex-end; padding: 8rpx 24rpx; border-top: 1rpx solid var(--line); }
.batch-row .ui-button { margin: 0; background: transparent; border: 0; color: var(--accent-ink); font-size: 24rpx; padding: 0 12rpx; }
.ui-button.manage-stations { display: inline-flex; width: auto; min-width: 0; flex: 0 0 auto; margin: 0 0 0 auto; padding: 0 0 0 16rpx; border: 0; line-height: 1.4; white-space: nowrap; color: var(--accent-ink); font-size: 26rpx; }
.home-station { position: relative; }
.home-station .parcel-row { padding-top: 12rpx; padding-bottom: 12rpx; }
.station-sorting { transition: transform var(--motion-duration) ease; will-change: transform; }
.station-lifted { z-index: 3; box-shadow: 0 8rpx 24rpx rgba(37,35,31,.12); transition: none; }
.drag-handle { flex-shrink: 0; min-width: 44px; min-height: 44px; line-height: 44px; text-align: center; margin: -12rpx 0 -12rpx -16rpx; color: var(--muted); font-size: 34rpx; }
.station-setting { padding: 24rpx; }
.station-setting-top { display: flex; align-items: center; gap: 16rpx; min-height: 44px; }
.drag-symbol { color: var(--muted); font-size: 34rpx; width: 44px; flex-shrink: 0; text-align: center; }
.detail-arrow { color: var(--secondary); font-size: 36rpx; }
.new-badge { color: var(--accent-ink); background: var(--surface); border-radius: 8rpx; font-size: 22rpx; padding: 4rpx 10rpx; flex-shrink: 0; }
.station-alias { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; font-size: 26rpx; line-height: 1.6; border-bottom: 1rpx solid var(--line); padding: 8rpx 0; }
.alias-name { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.station-alias .ui-button { flex-shrink: 0; font-size: 24rpx; }
.danger-button { color: var(--danger); background: var(--page); margin-top: 24rpx; border: 1rpx solid var(--line); }
.station-select { margin: 0; min-width: 100rpx; padding: 0 12rpx; font-size: 24rpx; border: 2rpx solid transparent; }
.station-select.option-selected { border-color: var(--accent-ink); }
.import-sources { display: flex; flex-direction: column; gap: 16rpx; margin: 32rpx 0 24rpx; }
.ui-button.import-source { justify-content: flex-start; width: 100%; margin: 0; min-height: 56px; display: flex; align-items: center; gap: 20rpx; padding: 24rpx 28rpx; line-height: 1.5; text-align: left; font-size: 30rpx; font-weight: 600; }
.source-symbol { width: 40rpx; font-size: 34rpx; text-align: center; }
.notification-composer { margin-top: 24rpx; }
.notification-input { display: block; width: 100%; height: 360rpx; padding: 24rpx; box-sizing: border-box; background: var(--card); color: var(--text); border: 1rpx solid var(--line); border-radius: var(--radius); font-size: 28rpx; line-height: 1.7; }
.ui-button.full-button { width: 100%; margin: 0; }
.notification-composer .full-button { margin-top: 16rpx; }
.clear-text { margin-left: auto; font-size: 24rpx; }
.privacy-link { margin: 24rpx auto 0; font-size: 24rpx; }
.progress-line { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 16rpx 24rpx; background: var(--surface); border-radius: var(--button-radius); color: var(--accent-ink); font-size: 26rpx; }
.progress-line .ui-button { flex-shrink: 0; }
.import-summary { padding: 28rpx; margin-top: 28rpx; }
.import-totals { display: flex; align-items: center; flex-wrap: wrap; gap: 16rpx; font-size: 36rpx; font-weight: 600; margin: 24rpx 0; }
.import-totals .pending-total { background: var(--surface); color: var(--accent-ink); margin: 0; padding: 0 16rpx; font-size: 26rpx; }
.category-links, .summary-actions { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 20rpx; }
.category-links .ui-button, .summary-actions .ui-button { margin: 0; font-size: 24rpx; padding: 0 16rpx; }
.category-links .ui-button { flex: 1; white-space: nowrap; color: var(--secondary); border: 0; background: var(--page); }
.summary-actions { border-top: 1rpx solid var(--line); padding-top: 20rpx; }
.category-details { margin-top: 24rpx; }
.image-result { display: flex; align-items: center; padding: 20rpx; gap: 20rpx; }
.result-thumbnail { width: 76rpx; height: 100rpx; border-radius: 8rpx; background: var(--page); flex-shrink: 0; }
.result-copy { flex: 1; min-width: 0; }
.result-label { font-size: 24rpx; color: var(--secondary); margin-bottom: 6rpx; }
.result-status { font-size: 26rpx; line-height: 1.5; overflow-wrap: anywhere; }
.image-result .ui-button { flex-shrink: 0; margin: 0; padding: 0 16rpx; font-size: 24rpx; }
.failure-banner { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin: 20rpx 0; color: var(--danger); }
.failure-banner .ui-button { margin: 0; flex-shrink: 0; }
.attention-row { display: flex; align-items: center; justify-content: space-between; padding: 20rpx 24rpx; background: var(--surface); color: var(--accent-ink); border-radius: var(--button-radius); margin-bottom: 24rpx; min-height: 44px; box-sizing: border-box; }
.error, .notice, .import-feedback { padding: 20rpx; margin: 16rpx 0; border-radius: var(--button-radius); font-size: 26rpx; line-height: 1.6; }
.error { background: var(--card); color: var(--danger); border: 1rpx solid var(--line); }
.notice, .import-feedback { background: var(--surface); color: var(--accent-ink); }
.success { color: var(--text); font-weight: 600; }
.result-heading { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin: 28rpx 0 16rpx; }
.result-heading .section-heading { margin: 0; }
.result-heading .ui-button { margin: 0; font-size: 24rpx; flex-shrink: 0; }
.draft-actions { display: flex; flex-wrap: wrap; gap: 8rpx; }
.import-result-actions { margin-top: 24rpx; padding: 16rpx 0; }
.swipe-shell { position: relative; overflow: hidden; border-bottom: 1rpx solid var(--line); }
.swipe-shell:last-child { border-bottom: 0; }
.swipe-content { position: relative; z-index: 1; background: var(--card); padding: 24rpx; transition: transform 180ms ease; }
.swipe-open { transform: translateX(-80px); }
.delete-button { position: absolute; right: 0; top: 0; bottom: 0; width: 80px; height: 100%; margin: 0; padding: 0; background: var(--danger); }
.delete-label { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; color: var(--card); font-size: 28rpx; font-weight: 600; }
.history-top, .history-bottom { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.history-top .code-scroll { flex: 1; }
.history-card .swipe-content { padding: 16rpx 24rpx; }
.history-station { font-size: 28rpx; margin: 4rpx 0; overflow-wrap: anywhere; line-height: 1.4; }
.history-bottom { margin-top: 8rpx; }
.history-bottom .hint { flex: 1; min-width: 0; margin: 0; }
.history-bottom .ui-button { margin: 0; font-size: 24rpx; }
.ui-button.history-menu { margin: 0; width: 44px; min-width: 44px; padding: 0; color: var(--text); }
.bottom-nav { position: fixed; bottom: 0; left: 0; right: 0; z-index: 10; display: flex; align-items: center; background: var(--page); border-top: 1rpx solid var(--line); padding: 10rpx 16rpx calc(10rpx + env(safe-area-inset-bottom)); }
.nav-item { flex: 1; margin: 0; padding: 4rpx 0; min-height: 56px; color: var(--secondary); font-size: 24rpx; line-height: 1.5; background: transparent; display: flex; flex-direction: column; justify-content: center; align-items: center; }
.nav-symbol { font-size: 36rpx; line-height: 1.2; margin-bottom: 4rpx; }
.nav-active { color: var(--accent-ink); font-weight: 600; }
.nav-import .nav-symbol { width: 48px; height: 48px; border-radius: 50%; background: var(--primary); color: var(--card); font-size: 36px; line-height: 45px; font-weight: 400; }
.undo-bar { position: fixed; z-index: 12; bottom: calc(98px + env(safe-area-inset-bottom)); left: 24rpx; right: 24rpx; padding: 12rpx 20rpx; background: var(--card); color: var(--text); border: 1rpx solid var(--line); border-radius: var(--button-radius); box-shadow: 0 4rpx 20rpx rgba(37,35,31,.08); display: flex; align-items: center; justify-content: space-between; gap: 16rpx; font-size: 24rpx; }
.undo-action { flex-shrink: 0; margin: 0; color: var(--accent-ink); background: transparent; }
.modal-mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 130; background: rgba(37,35,31,.3); display: flex; align-items: center; justify-content: center; padding: 16rpx; box-sizing: border-box; }
.edit-sheet { width: 100%; max-height: 85vh; overflow-y: auto; background: var(--card); border: 1rpx solid var(--line); border-radius: var(--radius); padding: 32rpx; box-sizing: border-box; }
.field-label { display: block; font-size: 24rpx; color: var(--secondary); margin: 24rpx 0 12rpx; }
.field-input, .station-input { width: 100%; box-sizing: border-box; background: var(--page); color: var(--text); border: 1rpx solid var(--line); border-radius: var(--button-radius); padding: 20rpx; font-size: 28rpx; min-height: 44px; line-height: 1.5; }
.actions { display: flex; gap: 20rpx; margin-top: 32rpx; }
.actions .ui-button { flex: 1; margin: 0; padding: 0 12rpx; }
.review-screen { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 20; display: flex; flex-direction: column; background: var(--page); }
.review-header { flex-shrink: 0; padding: 24rpx 28rpx 20rpx; }
/* The slot receives the remaining viewport height; only its scroll-view scrolls. */
.review-list-slot { position: relative; flex: 1; min-height: 0; }
.review-list { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
.review-item { padding: 24rpx 28rpx 32rpx; border-top: 1rpx solid var(--line); }
.review-code { font-size: 48rpx; }
.review-reason { color: var(--accent-ink); font-size: 26rpx; line-height: 1.6; margin: 16rpx 0; }
.match-info { margin-bottom: 16rpx; }
.match-station { font-size: 26rpx; line-height: 1.6; overflow-wrap: anywhere; }
.review-option { margin: 12rpx 0 0; padding: 24rpx; text-align: left; font-size: 26rpx; line-height: 1.5; color: var(--secondary); background: var(--card); border: 2rpx solid var(--line); }
.option-selected { border-color: var(--accent-ink); color: var(--accent-ink); background: var(--surface); }
.option-detail { display: block; font-size: 24rpx; margin-top: 6rpx; font-weight: 400; }
.review-footer { flex-shrink: 0; padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid var(--line); background: var(--card); }
.review-summary { font-size: 24rpx; color: var(--accent-ink); line-height: 1.6; }
.review-footer .actions { margin-top: 16rpx; }
.review-footer .ui-button { font-size: 26rpx; padding: 0 12rpx; }
.exception-progress { color: var(--secondary); font-size: 28rpx; text-align: center; font-variant-numeric: tabular-nums; }
.exception-parcel { padding: 24rpx 32rpx; text-align: center; }
.exception-screen .review-code { font-size: 60rpx; }
.exception-station { font-size: 30rpx; line-height: 1.5; margin-top: 16rpx; overflow-wrap: anywhere; }
.exception-screen .review-reason { color: var(--secondary); font-size: 28rpx; margin: 20rpx 0; }
.exception-sources { display: flex; flex-wrap: wrap; gap: 20rpx; margin: 28rpx 0; }
.exception-source { flex: 1 1 40%; min-width: 0; max-width: 100%; }
.exception-thumbnail { display: block; width: 100%; height: 270rpx; margin: 10rpx 0; border-radius: var(--button-radius); background: var(--card); border: 1rpx solid var(--line); box-sizing: border-box; }
.source-expired { padding: 20rpx 10rpx; background: var(--card); border-radius: var(--button-radius); color: var(--secondary); font-size: 24rpx; }
.existing-evidence, .evidence-details { margin: 20rpx 0; text-align: left; overflow-wrap: anywhere; padding: 20rpx; background: var(--card); border: 1rpx solid var(--line); border-radius: var(--button-radius); }
.existing-evidence .field-label { margin-top: 0; }
.exception-actions { max-height: 58vh; overflow-y: auto; }
.exception-actions .ui-button { display: block; width: 100%; line-height: 1.5; padding: 20rpx; margin: 12rpx 0 0; font-size: 28rpx; }
.exception-actions .ui-button:first-child { margin-top: 0; }
/* Only transient display rows animate; storage updates remain immediate. */
.page-panel, .draft-section { animation: panel-in var(--motion-duration) ease-out; }
.notification-composer, .edit-sheet { animation: sheet-in var(--motion-duration) ease-out; }
.group-content { display: grid; grid-template-rows: 1fr; opacity: 1; transition: grid-template-rows var(--motion-duration) ease, opacity var(--motion-duration) ease; }
.group-content.is-collapsed { grid-template-rows: 0fr; opacity: 0; pointer-events: none; }
.group-inner, .exit-inner { overflow: hidden; min-height: 0; }
.exit-row, .station-exit { display: grid; grid-template-rows: 1fr; }
.station-exit-inner { min-height: 0; }
.row-leaving, .station-leaving { pointer-events: none; animation: row-out var(--motion-duration) ease forwards; }
.station-leaving .station-exit-inner { overflow: hidden; }
.station-leaving .row-leaving { animation: none; }
@keyframes panel-in { from { opacity: 0; } to { opacity: 1; } }
@keyframes sheet-in { from { opacity: 0; transform: translateY(8rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes row-out { to { grid-template-rows: 0fr; opacity: 0; } }
@media (max-width: 360px) {
  .pickup { padding-left: 24rpx; padding-right: 24rpx; }
  .parcel-row { padding: 20rpx; gap: 12rpx; }
  .pickup-code { font-size: 50rpx; }
  .hint, .record-meta, .station-count, .text-action, .field-label, .category-links .ui-button, .privacy-link, .nav-item { font-size: 12px; }
  .parcel-row .ui-button { padding: 0 14rpx; }
}
.reduce-motion .page-panel, .reduce-motion .notification-composer, .reduce-motion .edit-sheet, .reduce-motion .draft-section, .reduce-motion .row-leaving, .reduce-motion .station-leaving { animation: none; }
.reduce-motion .group-content, .reduce-motion .swipe-content, .reduce-motion .home-station, .reduce-motion .ui-button { transition: none; }
.reduce-motion .button-pressed { transform: none; }
@media (prefers-reduced-motion: reduce) {
  .page-panel, .notification-composer, .edit-sheet, .draft-section, .row-leaving, .station-leaving { animation: none; }
  .group-content, .swipe-content, .home-station, .ui-button { transition: none; }
  .ui-button.button-pressed { transform: none; }
}
