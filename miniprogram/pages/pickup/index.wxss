.pickup { background: var(--page); color: var(--text); font-size: 28rpx; min-height: 100vh; box-sizing: border-box; padding: 28rpx 32rpx calc(184rpx + env(safe-area-inset-bottom)); }
.heading { font-size: 36rpx; line-height: 1.4; font-weight: 700; }
.count { font-size: 44rpx; color: var(--accent); }
.page-header { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 20rpx; }
.hint, .subtitle { color: var(--secondary); font-size: 24rpx; line-height: 1.6; margin-top: 8rpx; }
.subtitle { margin-bottom: 20rpx; }
.ui-button { width: auto; font-size: 28rpx; border-radius: 20rpx; font-weight: 500; line-height: 2.8; }
.ui-button::after { border: 0; }
.primary { background: var(--accent); color: var(--page); }
.secondary { background: var(--surface); color: var(--accent); }
.ui-button.ui-disabled { background: var(--surface); color: var(--muted); }
.card { background: var(--card); border-radius: 24rpx; border: 1rpx solid var(--line); box-shadow: 0 2rpx 8rpx rgba(0,0,0,.08); margin-bottom: 24rpx; overflow: hidden; }
.station-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; padding: 24rpx; }
.station-name { font-size: 28rpx; font-weight: 600; line-height: 1.6; overflow-wrap: anywhere; word-break: break-all; flex: 1; min-width: 0; }
.station-count { flex-shrink: 0; color: var(--secondary); font-size: 24rpx; line-height: 1.8; }
.review { color: var(--accent); }
.parcel-row { display: flex; align-items: center; gap: 16rpx; padding: 24rpx; border-top: 1rpx solid var(--line); }
.parcel-main { flex: 1; min-width: 0; }
.pickup-code { display: block; font-size: 52rpx; font-weight: 700; line-height: 1.35; letter-spacing: 1rpx; overflow-wrap: anywhere; word-break: break-all; font-variant-numeric: tabular-nums; }
.record-meta { margin-top: 6rpx; font-size: 24rpx; color: var(--secondary); }
.text-action { display: inline-block; padding: 8rpx 12rpx 8rpx 0; color: var(--accent); }
.parcel-row .ui-button { flex-shrink: 0; margin: 0; padding: 0 18rpx; font-size: 25rpx; line-height: 72rpx; }
.take-button { color: var(--accent); background: var(--surface); }
.empty { padding: 64rpx 12rpx; text-align: center; color: var(--secondary); }
.section-title { font-size: 30rpx; font-weight: 600; margin-bottom: 12rpx; }
.section-heading { font-weight: 600; font-size: 30rpx; margin: 24rpx 0 16rpx; }
.small-heading { font-size: 26rpx; color: var(--secondary); }
.inline { margin-left: 16rpx; font-weight: 400; }
.progress-line { display: flex; align-items: center; justify-content: space-between; color: var(--accent); font-size: 26rpx; }
.text-button { color: var(--secondary); background: transparent; margin: 0; padding: 0 12rpx; }
.image-result { display: flex; align-items: center; padding: 20rpx; gap: 20rpx; }
.result-thumbnail { width: 76rpx; height: 100rpx; border-radius: 8rpx; background: var(--surface); flex-shrink: 0; }
.result-copy { flex: 1; min-width: 0; }
.result-label { font-size: 24rpx; color: var(--secondary); margin-bottom: 6rpx; }
.result-status { font-size: 28rpx; color: var(--secondary); line-height: 1.5; }
.success { color: var(--accent); font-weight: 600; }
.image-result .ui-button { flex-shrink: 0; margin: 0; }
.error, .notice { padding: 20rpx; margin: 16rpx 0; border-radius: 12rpx; font-size: 25rpx; line-height: 1.6; }
.error { background: var(--surface); color: var(--danger); }
.notice { background: var(--surface); color: var(--accent); }
.swipe-shell { position: relative; overflow: hidden; border-bottom: 1rpx solid var(--line); }
.swipe-content { position: relative; z-index: 1; background: var(--card); padding: 24rpx; transition: transform 180ms ease; }
.swipe-open { transform: translateX(-80px); }
.delete-label { position: absolute; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: center; color: var(--card); font-size: 28rpx; font-weight: 600; line-height: 1.5; }
.delete-button { position: absolute; right: 0; top: 0; bottom: 0; width: 80px; height: 100%; padding: 0; margin: 0; border-radius: 0; background: var(--danger); color: var(--page); display: flex; align-items: center; justify-content: center; font-size: 28rpx; }
.history-top, .history-bottom { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.history-top .pickup-code { flex: 1; min-width: 0; }
.history-station { font-size: 28rpx; color: var(--secondary); margin: 12rpx 0; word-break: break-all; line-height: 1.6; }
.history-bottom .ui-button { margin: 0; font-size: 24rpx; }
.bottom-nav { position: fixed; bottom: 0; left: 0; right: 0; z-index: 10; display: flex; background: var(--card); border-top: 1rpx solid var(--line); padding: 8rpx 16rpx calc(8rpx + env(safe-area-inset-bottom)); }
.nav-item { flex: 1; margin: 0; padding: 6rpx 0; border-radius: 12rpx; color: var(--muted); font-size: 23rpx; line-height: 1.5; background: transparent; display: flex; flex-direction: column; align-items: center; }
.nav-symbol { font-size: 36rpx; line-height: 1.2; margin-bottom: 4rpx; }
.nav-active { color: var(--accent); background: var(--surface); font-weight: 600; }
.undo-bar { position: fixed; z-index: 12; bottom: calc(128rpx + env(safe-area-inset-bottom)); left: 28rpx; right: 28rpx; padding: 16rpx 24rpx; background: var(--text); color: var(--card); border-radius: 20rpx; display: flex; align-items: center; justify-content: space-between; font-size: 25rpx; }
.undo-action { margin: 0; color: var(--accent); background: transparent; }
.modal-mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 20; background: rgba(0,0,0,.55); display: flex; align-items: center; justify-content: center; padding: 28rpx; }
.edit-sheet { width: 100%; max-height: 80vh; overflow-y: auto; background: var(--card); border-radius: 24rpx; padding: 32rpx; box-sizing: border-box; }
.field-label { display: block; font-size: 24rpx; color: var(--secondary); margin: 24rpx 0 12rpx; }
.field-input, .station-input { width: 100%; box-sizing: border-box; background: var(--surface); border-radius: 12rpx; padding: 20rpx; font-size: 28rpx; min-height: 80rpx; line-height: 1.5; }
.actions { display: flex; gap: 20rpx; margin-top: 32rpx; }
.actions .ui-button { flex: 1; margin: 0; }
@media (prefers-reduced-motion: reduce) { .swipe-content { transition: none; } }

.import-feedback { padding: 20rpx 24rpx; margin-bottom: 24rpx; border-radius: 20rpx; background: var(--surface); color: var(--accent); font-size: 25rpx; line-height: 1.6; }
.copy-code { padding: 4rpx 0; }
.review-sheet { width: 100%; max-height: 84vh; background: var(--card); border-radius: 24rpx; display: flex; flex-direction: column; overflow: hidden; }
.review-header { padding: 28rpx 28rpx 20rpx; }
.review-list { flex: 1; min-height: 0; height: 48vh; }
.review-item { padding: 24rpx 28rpx; border-top: 1rpx solid var(--line); }
.review-code { font-size: 34rpx; font-weight: 700; word-break: break-all; }
.review-reason { color: var(--accent); font-size: 24rpx; line-height: 1.6; margin: 16rpx 0; }
.match-info { margin-bottom: 16rpx; }
.match-station { font-size: 26rpx; line-height: 1.6; word-break: break-all; }
.review-option { margin: 12rpx 0 0; padding: 24rpx; text-align: left; font-size: 25rpx; line-height: 1.5; color: var(--secondary); background: var(--page); border: 2rpx solid transparent; }
.option-selected { border-color: var(--accent); color: var(--accent); background: var(--surface); }
.option-detail { display: block; font-size: 22rpx; margin-top: 6rpx; font-weight: 400; }
.review-footer { padding: 20rpx 28rpx 28rpx; border-top: 1rpx solid var(--line); }
.review-summary { font-size: 24rpx; color: var(--accent); line-height: 1.6; }
.review-footer .actions { margin-top: 16rpx; }
.review-footer .ui-button { font-size: 25rpx; padding: 0 12rpx; }

.station-tools { display: flex; justify-content: flex-end; margin: 0 0 16rpx; }
.station-tools .ui-button { font-size: 24rpx; }
.batch-row { display: flex; justify-content: flex-end; padding: 10rpx 20rpx; border-top: 1rpx solid var(--line); }
.batch-row .ui-button { font-size: 24rpx; line-height: 64rpx; padding: 0 20rpx; border: 1rpx solid var(--line); margin: 0; }
.station-setting { padding: 24rpx; }
.station-setting-top { display: flex; align-items: center; gap: 12rpx; }
.station-setting-top .ui-button { flex-shrink: 0; }
.station-alias { display: flex; align-items: center; justify-content: space-between; font-size: 23rpx; line-height: 1.7; color: var(--secondary); margin-top: 12rpx; gap: 16rpx; }
.alias-name { flex: 1; min-width: 0; word-break: break-all; }
.station-alias .ui-button { flex-shrink: 0; font-size: 23rpx; }
.station-order { display: flex; justify-content: flex-end; gap: 20rpx; margin-top: 16rpx; }
.station-order .ui-button { margin: 0; font-size: 24rpx; }

.station-select { margin: 0; min-width: 100rpx; padding: 0 12rpx; font-size: 23rpx; border: 2rpx solid transparent; }
.station-select.option-selected { border-color: var(--accent); }

.ui-button.manage-stations { width: 190rpx; margin: 0 0 0 auto; padding: 0 12rpx; line-height: 72rpx; border: 1rpx solid var(--line); }
.home-station { position: relative; }
.station-sorting { transition: transform 200ms ease; will-change: transform; }
.station-lifted { z-index: 3; box-shadow: 0 12rpx 32rpx rgba(0,0,0,.25); transition: none; }
.drag-handle { flex-shrink: 0; padding: 4rpx 12rpx; margin: -8rpx -8rpx -8rpx -12rpx; color: var(--muted); font-size: 38rpx; line-height: 1.3; }
.draft-actions { display: flex; align-items: center; gap: 8rpx; }
.parcel-row .draft-actions .ui-button { font-size: 24rpx; line-height: 72rpx; padding: 0 14rpx; }
.import-result-actions { margin-top: 24rpx; }
.import-result-actions .text-button { font-size: 25rpx; }
@media (prefers-reduced-motion: reduce) { .station-sorting { transition: none; } }

.import-sources { display: flex; flex-direction: column; gap: 16rpx; margin-top: 24rpx; }
.ui-button.import-source { width: 100%; margin: 0; min-height: 100rpx; display: flex; align-items: center; gap: 20rpx; padding: 24rpx 28rpx; box-sizing: border-box; line-height: 1.5; text-align: left; font-size: 30rpx; font-weight: 600; }
.import-source.secondary { background: var(--card); border: 1rpx solid var(--line); }
.source-symbol { width: 42rpx; font-size: 36rpx; text-align: center; }
.notification-composer { margin-top: 24rpx; }
.notification-input { display: block; width: 100%; height: 360rpx; padding: 24rpx; box-sizing: border-box; background: var(--card); color: var(--text); border: 1rpx solid var(--line); border-radius: 20rpx; font-size: 28rpx; line-height: 1.7; }
.ui-button.full-button { width: 100%; margin: 0; line-height: 88rpx; }
.notification-composer .full-button { margin-top: 16rpx; }
.clear-text { margin-left: auto; font-size: 24rpx; line-height: 72rpx; }
.result-heading { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin: 28rpx 0 16rpx; }
.result-heading .section-heading { margin: 0; }
.result-heading .ui-button { margin: 0; font-size: 24rpx; flex-shrink: 0; }
.session-actions { display: flex; justify-content: space-between; }
.session-actions .ui-button { flex: 1; line-height: 76rpx; }
.privacy-link { margin: 24rpx auto 0; font-size: 24rpx; line-height: 76rpx; }

/* All product colors come from app.wxss. */
.heading { font-weight: 600; }
.app-title { color: var(--secondary); font-size: 26rpx; margin-bottom: 12rpx; }
.count, .pickup-code, .review-code { color: var(--text); }
.pickup-code { font-weight: 600; }
.review-code { font-size: 48rpx; }
.ui-button { border-radius: 18rpx; min-height: 88rpx; }
.ui-button[disabled] { background: var(--surface); color: var(--muted); opacity: .65; }
.text-action { min-height: 64rpx; line-height: 64rpx; padding: 0 16rpx 0 0; }
.parcel-row .ui-button, .parcel-row .draft-actions .ui-button, .batch-row .ui-button { line-height: 88rpx; }
.parcel-row { flex-wrap: wrap; }
.parcel-main { min-width: 240rpx; }
.draft-actions { margin-left: auto; }
.station-count { color: var(--muted); }
.station-tools { align-items: center; justify-content: space-between; margin-bottom: 24rpx; }
.ui-button.manage-stations { width: auto; line-height: 88rpx; padding: 0 24rpx; }
.motion-toggle { font-size: 22rpx; color: var(--muted); }
.drag-handle { min-width: 64rpx; min-height: 88rpx; line-height: 88rpx; text-align: center; margin-top: -16rpx; }
.home-station { transition: transform 200ms ease; }
.station-lifted { transition: none; }
.batch-row .ui-button { border: 0; background: transparent; color: var(--accent); }
.bottom-nav { background: var(--page); align-items: center; padding-top: 12rpx; }
.nav-item { min-height: 96rpx; justify-content: center; }
.nav-active { background: transparent; color: var(--accent); }
.nav-import .nav-symbol { width: 88rpx; height: 88rpx; border-radius: 50%; background: var(--accent); color: var(--page); font-size: 56rpx; line-height: 82rpx; font-weight: 400; }
.nav-import { overflow: visible; }
.nav-symbol { height: 40rpx; }
.undo-bar { bottom: calc(154rpx + env(safe-area-inset-bottom)); background: var(--surface); color: var(--text); border: 1rpx solid var(--line); }
.delete-label { color: var(--page); }
.history-state { font-size: 22rpx; color: var(--muted); flex-shrink: 0; }
.history-bottom { flex-wrap: wrap; }
.history-bottom .hint { margin: 0; }
.ui-button.import-source { background: var(--card); color: var(--text); border: 1rpx solid var(--line); border-radius: 24rpx; min-height: 132rpx; }
.source-symbol { color: var(--accent); }
.import-result-actions { position: sticky; bottom: calc(148rpx + env(safe-area-inset-bottom)); background: var(--page); padding: 16rpx 0; z-index: 4; }
.field-input, .station-input { color: var(--text); }
.page-panel { animation: panel-in 200ms ease-out; }
.notification-composer, .edit-sheet { animation: sheet-in 220ms ease-out; }
.draft-section { animation: panel-in 180ms ease-out; }
.group-content { display: grid; grid-template-rows: 1fr; opacity: 1; transition: grid-template-rows 220ms ease, opacity 220ms ease; }
.group-content.is-collapsed { grid-template-rows: 0fr; opacity: 0; pointer-events: none; }
.group-inner { overflow: hidden; min-height: 0; }
.exit-row { display: grid; grid-template-rows: 1fr; }
.exit-inner { min-height: 0; overflow: hidden; }
.row-leaving { pointer-events: none; animation: row-out 200ms ease forwards; }
@keyframes panel-in { from { opacity: 0; } to { opacity: 1; } }
@keyframes sheet-in { from { opacity: 0; transform: translateY(12rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes row-out { to { grid-template-rows: 0fr; opacity: 0; } }
.reduce-motion .page-panel, .reduce-motion .notification-composer, .reduce-motion .edit-sheet, .reduce-motion .draft-section, .reduce-motion .row-leaving { animation: none; }
.reduce-motion .group-content, .reduce-motion .swipe-content, .reduce-motion .home-station { transition: none; }
@media (prefers-reduced-motion: reduce) {
  .page-panel, .notification-composer, .edit-sheet, .draft-section, .row-leaving { animation: none; }
  .group-content, .swipe-content, .home-station { transition: none; }
}
