<page-meta page-style="{{(dragId || reviewOpen || exceptionOpen || editing || stationEditor) ? 'overflow: hidden;' : ''}}" />
<view class="pickup {{reduceMotion ? 'reduce-motion' : ''}}" bindtap="closeDelete">
  <view hidden="{{reviewOpen || exceptionOpen}}">
  <view wx:if="{{storageError}}" class="error" role="alert">{{storageError}}</view>
  <view wx:if="{{error && activeTab !== 'import' && errorScope !== 'import'}}" class="error" role="alert">{{error}}</view>
  <view wx:if="{{stationError}}" class="error" role="alert">{{stationError}}</view>
  <view wx:if="{{batchError}}" class="notice" role="status">{{batchError}}</view>
  <view class="page-panel" wx:if="{{activeTab === 'home'}}">
    <view class="page-header"><view class="heading">待取件 <text class="count">{{remaining}}</text></view><button hover-class="button-pressed" hover-start-time="0" hover-stay-time="0" class="ui-button text-button manage-stations" catchtap="openStations">管理驿站</button></view>
    <view wx:if="{{exceptionCount}}" class="attention-row" hover-class="button-pressed" bindtap="openExceptions" role="button">待处理 {{exceptionCount}} 件 <text>›</text></view>
    <view wx:if="{{failureCount}}" class="failure-banner"><text>{{failureCount}} 张识别失败</text><button class="ui-button secondary" hover-class="button-pressed" bindtap="retryFailures">重试</button></view>
    <view wx:if="{{!remaining}}" class="empty">暂无待取快递</view>
    <view wx:for="{{visiblePendingGroups}}" wx:key="id" wx:for-item="group" class="station-exit {{group.leaving ? 'station-leaving' : ''}}"><view class="station-exit-inner"><view class="card station-card home-station {{group.sortable ? 'sortable-station' : ''}} {{dragId === group.id ? 'station-lifted' : ''}} {{dragId ? 'station-sorting' : ''}}" style="{{group.dragStyle}}">
      <view class="station-header" data-station="{{group.station}}" catchtap="toggleGroup" role="button" aria-label="{{group.collapsed ? '展开' : '收起'}}{{group.station}}"><view wx:if="{{group.sortable && locationCount > 1}}" class="drag-handle" data-id="{{group.id}}" bindtouchstart="stationTouchStart" bindtouchmove="moveStationDrag" bindtouchend="finishStationDrag" bindtouchcancel="cancelStationDrag" catchlongpress="beginStationDrag" catchtap="noop" role="button" aria-label="长按拖动{{group.station}}排序">⠿</view><view class="station-mark" aria-hidden="true"></view><view class="station-name {{group.station === '待确认地点' ? 'review' : ''}}">{{group.station}}</view><text class="station-count">{{group.items.length}} 件　{{group.collapsed ? '＋' : '−'}}</text></view>

      <view class="group-content {{group.collapsed ? 'is-collapsed' : ''}}" aria-hidden="{{group.collapsed}}"><view class="group-inner">
        <view wx:for="{{group.items}}" wx:key="id" class="exit-row {{item.leaving ? 'row-leaving' : ''}}"><view class="exit-inner"><view class="parcel-row">
          <view class="parcel-main"><view wx:if="{{item.pickupAddress}}" class="hint">取件地址：{{item.pickupAddress}}</view><scroll-view class="code-scroll" scroll-x="{{true}}"><text class="pickup-code copy-code" data-id="{{item.id}}" catchtap="copyCode" role="button" aria-label="复制取件码 {{item.code}}">{{item.code}}</text></scroll-view><view class="record-meta"><text wx:if="{{item.carrier}}">{{item.carrier}} · </text><view hover-class="button-pressed" hover-start-time="0" hover-stay-time="0" class="text-action" data-id="{{item.id}}" catchtap="editRecord" role="button">{{group.station === '待确认地点' ? '补充地点' : '修改'}}</view></view></view>
          <button hover-class="{{(importing || deleting || storageBlocked || dragId) ? 'none' : 'button-pressed'}}" hover-start-time="0" hover-stay-time="0" size="mini" class="ui-button {{(importing || deleting || storageBlocked) ? 'ui-disabled' : ''}} take-button" data-id="{{item.id}}" catchtap="toggleTaken" disabled="{{importing || deleting || storageBlocked || dragId}}">已取到</button>
        </view></view></view>
      <view wx:if="{{group.items.length > 1}}" class="batch-row"><button hover-class="{{(importing || deleting || storageBlocked || dragId) ? 'none' : 'button-pressed'}}" hover-start-time="0" hover-stay-time="0" size="mini" class="ui-button {{(importing || deleting || storageBlocked || dragId) ? 'ui-disabled' : ''}} secondary batch-take-button" data-id="{{group.id}}" catchtap="takeStation" disabled="{{importing || deleting || storageBlocked || dragId}}">整站已取</button></view>
      </view></view>
    </view></view></view>
  </view>

  <view class="page-panel" wx:if="{{activeTab === 'import'}}">
    <view class="heading">{{notificationOpen ? '粘贴通知' : '导入快递'}}</view>
    <view wx:if="{{notificationOpen}}" class="notification-composer">
      <textarea class="notification-input" value="{{notificationText}}" bindinput="notificationInput" placeholder="请粘贴完整的快递取件通知" maxlength="20000" cursor-spacing="24" disabled="{{choosing || importing}}" adjust-position="{{true}}" aria-label="完整快递取件通知" />
      <view wx:if="{{error}}" class="error" role="alert">{{error}}</view>
      <button hover-class="{{(choosing || importing) ? 'none' : 'button-pressed'}}" hover-start-time="0" hover-stay-time="0" wx:if="{{notificationText}}" class="ui-button {{(choosing || importing) ? 'ui-disabled' : ''}} text-button clear-text" bindtap="clearNotificationText" disabled="{{choosing || importing}}">清空文字</button>
      <button hover-class="{{(!notificationText || choosing || importing) ? 'none' : 'button-pressed'}}" hover-start-time="0" hover-stay-time="0" class="ui-button {{(!notificationText || choosing || importing) ? 'ui-disabled' : ''}} primary full-button" bindtap="recognizeNotification" disabled="{{!notificationText || choosing || importing}}" loading="{{choosing}}">识别通知</button>
      <button hover-class="{{(choosing || importing) ? 'none' : 'button-pressed'}}" hover-start-time="0" hover-stay-time="0" class="ui-button {{(choosing || importing) ? 'ui-disabled' : ''}} text-button" bindtap="cancelNotification" disabled="{{choosing || importing}}">取消</button>
    </view>
    <block wx:else>
      <view class="import-sources">
        <button hover-class="{{(loading || choosing || importing) ? 'none' : 'button-pressed'}}" hover-start-time="0" hover-stay-time="0" class="ui-button {{(loading || choosing || importing) ? 'ui-disabled' : ''}} primary import-source" bindtap="chooseImage" disabled="{{loading || choosing || importing}}" loading="{{choosing}}"><text class="source-symbol">▧</text><text>{{completed ? '继续选择截图' : '从相册选择截图'}}</text></button>
        <button hover-class="{{(loading || choosing || importing) ? 'none' : 'button-pressed'}}" hover-start-time="0" hover-stay-time="0" class="ui-button {{(loading || choosing || importing) ? 'ui-disabled' : ''}} secondary import-source" bindtap="openNotification" disabled="{{loading || choosing || importing}}"><text class="source-symbol">≡</text><text>粘贴通知</text></button>
      </view>
      <view wx:if="{{error}}" class="error" role="alert">{{error}}</view>
      <view wx:if="{{loading}}" class="progress-line"><text>{{progress}}</text><button hover-class="button-pressed" hover-start-time="0" hover-stay-time="0" size="mini" class="ui-button text-button" bindtap="cancelRecognition">停止本批</button></view>
      <view wx:if="{{visibleDraftGroups.length}}" class="draft-section">
        <view class="result-heading"><view class="section-heading">核对结果 <text class="hint inline">{{validDraftCount}} 件</text></view><button hover-class="{{(importing) ? 'none' : 'button-pressed'}}" hover-start-time="0" hover-stay-time="0" wx:if="{{notificationText}}" size="mini" class="ui-button {{(importing) ? 'ui-disabled' : ''}} text-button" bindtap="openNotification" disabled="{{importing}}">修改文字</button></view>
        <view wx:if="{{mock}}" class="notice">模拟示例，与截图内容无关。</view>
        <view wx:for="{{visibleDraftGroups}}" wx:key="station" wx:for-item="group" class="station-exit {{group.leaving ? 'station-leaving' : ''}}"><view class="station-exit-inner"><view class="card station-card">
          <view class="station-header"><view class="station-name {{group.station === '待确认地点' ? 'review' : ''}}">{{group.station}}</view><text class="station-count">{{group.validCount}} 件</text></view>
          <view wx:for="{{group.items}}" wx:key="id" class="exit-row {{item.leaving ? 'row-leaving' : ''}}"><view class="exit-inner"><view class="parcel-row">
            <view class="parcel-main"><view wx:if="{{item.pickupAddress}}" class="hint">取件地址：{{item.pickupAddress}}</view><scroll-view class="code-scroll" scroll-x="{{true}}"><text class="pickup-code" user-select="{{true}}">{{item.code || '号码缺失'}}</text></scroll-view><view wx:if="{{item.carrier}}" class="record-meta">{{item.carrier}}</view></view>
            <view class="draft-actions"><button hover-class="{{(importing) ? 'none' : 'button-pressed'}}" hover-start-time="0" hover-stay-time="0" size="mini" class="ui-button {{(importing) ? 'ui-disabled' : ''}} secondary" data-id="{{item.id}}" bindtap="editRecord" disabled="{{importing}}">修改</button><button hover-class="{{(importing) ? 'none' : 'button-pressed'}}" hover-start-time="0" hover-stay-time="0" size="mini" class="ui-button {{(importing) ? 'ui-disabled' : ''}} text-button" data-id="{{item.id}}" bindtap="removeDraft" disabled="{{importing}}">移除</button></view>
          </view></view></view>
        </view></view></view>
      </view>
      <view wx:if="{{drafts.length}}" class="import-result-actions">
        <button class="ui-button {{(!validDraftCount || loading || importing || storageBlocked) ? 'ui-disabled' : ''}} primary full-button" hover-class="button-pressed" bindtap="confirmImport" disabled="{{!validDraftCount || loading || importing || storageBlocked}}">确认导入 {{validDraftCount}} 件</button>
      </view>
      <view wx:if="{{recentImport && !recentImport.undone && !loading && !recentImport.interrupted}}" class="card import-summary">
        <view class="section-title">整理完成</view>
        <view class="import-totals"><text>新增 {{recentImport.added}} 件</text><button wx:if="{{recentImport.reviewCount}}" class="ui-button pending-total" hover-class="button-pressed" bindtap="openExceptions">待处理 {{recentImport.reviewCount}} 件 ›</button></view>
        <view class="category-links">
          <button class="ui-button secondary" hover-class="button-pressed" data-category="duplicate" bindtap="showResultCategory">重复 {{recentImport.duplicate}} ›</button>
          <button class="ui-button secondary" hover-class="button-pressed" data-category="unrelated" bindtap="showResultCategory">无关 {{recentImport.unrelated}} ›</button>
          <button class="ui-button secondary" hover-class="button-pressed" data-category="failure" bindtap="showResultCategory">失败 {{recentImport.failures}} ›</button>
        </view>
        <view wx:if="{{recentImport.failures}}" class="failure-banner"><text>{{recentImport.failures}} 张识别失败</text><button class="ui-button primary" hover-class="button-pressed" data-batch-id="{{recentImport.id}}" bindtap="retryFailures">重试</button></view>
        <view class="summary-actions"><button class="ui-button secondary" hover-class="button-pressed" bindtap="viewPending">查看待取件</button><button wx:if="{{recentImport.canUndo}}" class="ui-button {{(importing || storageBlocked) ? 'ui-disabled' : ''}} text-button" hover-class="button-pressed" bindtap="undoImport" disabled="{{importing || storageBlocked}}">撤销导入</button></view>
      </view>
      <button wx:if="{{exceptionCount > recentImport.reviewCount}}" class="ui-button secondary full-button" hover-class="button-pressed" bindtap="openExceptions">待处理 {{exceptionCount}} 件 ›</button>
      <view wx:if="{{failureCount > recentImport.failures}}" class="failure-banner"><text>另有 {{failureCount - recentImport.failures}} 张识别失败</text><button class="ui-button secondary" hover-class="button-pressed" bindtap="retryFailures">重试</button></view>
      <view wx:if="{{resultCategory}}" class="category-details">
        <view class="page-header"><view class="section-title">{{categoryTitle}} · {{categoryItems.length}} 张</view><button class="ui-button text-button" hover-class="button-pressed" bindtap="closeResultCategory">收起</button></view>
        <view wx:if="{{!categoryItems.length}}" class="empty">暂无{{categoryTitle}}截图</view>
        <view wx:for="{{categoryItems}}" wx:key="key" class="card image-result">
          <image wx:if="{{item.path}}" class="result-thumbnail" src="{{item.path}}" mode="aspectFill" data-batch-id="{{item.batchId}}" data-image-index="{{item.index}}" bindtap="previewResultImage" />
          <view class="result-copy"><view class="result-label">截图 {{item.index + 1}}</view><view class="result-status">{{item.reason}}</view></view>
          <button wx:if="{{item.retryable}}" class="ui-button {{(loading || choosing || storageBlocked) ? 'ui-disabled' : ''}} primary" hover-class="button-pressed" data-batch-id="{{item.batchId}}" data-image-index="{{item.index}}" bindtap="retryImage" disabled="{{loading || choosing || storageBlocked}}">{{item.path ? '重试' : '选图重试'}}</button>
        </view>
      </view>
    </block>
    <button hover-class="button-pressed" hover-start-time="0" hover-stay-time="0" class="ui-button text-button privacy-link" bindtap="showImportPrivacy">隐私说明</button>
  </view>

  <view class="page-panel" wx:if="{{activeTab === 'history'}}">
    <view class="page-header"><view class="heading">已取历史</view><button wx:if="{{history.length}}" class="ui-button {{(deleting || importing || storageBlocked) ? 'ui-disabled' : ''}} secondary history-menu" hover-class="button-pressed" aria-label="历史菜单" bindtap="openHistoryMenu" disabled="{{deleting || importing || storageBlocked}}">•••</button></view>
    <view wx:if="{{!history.length}}" class="empty">暂无已取件记录</view>
    <view class="card history-card" wx:if="{{visibleHistory.length}}">
      <view wx:for="{{visibleHistory}}" wx:key="id" class="swipe-shell exit-row {{item.leaving ? 'row-leaving' : ''}}" data-id="{{item.id}}" bindtouchstart="touchStart" bindtouchmove="touchMove" bindtouchend="touchEnd" bindtouchcancel="touchCancel" catchtap="recordTap">
        <view class="exit-inner"><view wx:if="{{openDeleteId === item.id || swipeId === item.id}}" class="delete-button" hover-class="button-pressed" hover-start-time="0" hover-stay-time="0" role="button" aria-label="删除已取件记录" data-id="{{item.id}}" catchtap="deleteRecord"><text class="delete-label">删除</text></view>
        <view class="swipe-content {{openDeleteId === item.id ? 'swipe-open' : ''}}" style="{{swipeId === item.id ? swipeStyle : ''}}">
          <view class="history-top"><scroll-view class="code-scroll" scroll-x="{{true}}" catchtouchstart="noop" catchtouchmove="noop" catchtouchend="noop" catchtouchcancel="noop"><text class="pickup-code" user-select="{{true}}">{{item.code}}</text></scroll-view></view>
          <view class="history-station">{{item.station}}</view><view wx:if="{{item.pickupAddress}}" class="hint">取件地址：{{item.pickupAddress}}</view>
          <view class="history-bottom"><text class="hint">{{item.takenTimeLabel}}{{item.carrier ? ' · ' + item.carrier : ''}}</text><button hover-class="{{(importing || deleting || storageBlocked) ? 'none' : 'button-pressed'}}" hover-start-time="0" hover-stay-time="0" size="mini" class="ui-button {{(importing || deleting || storageBlocked) ? 'ui-disabled' : ''}} secondary" data-id="{{item.id}}" catchtap="toggleTaken" disabled="{{importing || deleting || storageBlocked}}">恢复待取</button></view>
        </view></view>
      </view>
    </view>
  </view>

  <view class="page-panel" wx:if="{{activeTab === 'stations'}}">
    <view class="heading">管理驿站</view>
    <view wx:if="{{!stationList.length}}" class="empty">导入快递后，这里会列出已知取件地点。</view>
    <view wx:for="{{stationList}}" wx:key="id" wx:for-item="station" class="card station-setting sortable-station {{dragId === station.id ? 'station-lifted' : ''}}" style="{{station.dragStyle}}" data-id="{{station.id}}" bindtap="openStationDetail" bindtouchstart="stationTouchStart" bindtouchmove="moveStationDrag" bindtouchend="finishStationDrag" bindtouchcancel="cancelStationDrag" catchlongpress="beginStationDrag" role="button" aria-label="{{station.name}}，长按拖动排序，点击详情">
      <view class="station-setting-top"><text class="drag-symbol" aria-hidden="true">⠿</text><view class="parcel-main"><view class="station-name">{{station.name}}</view></view><text wx:if="{{station.discoveryStatus === 'discovered' && !station.confirmed}}" class="new-badge">新</text><text class="detail-arrow">›</text></view>
    </view>
    <button class="ui-button {{(stationBusy || stationBlocked || storageBlocked) ? 'ui-disabled' : ''}} text-button" bindtap="addStation" disabled="{{stationBusy || stationBlocked || storageBlocked}}">添加驿站</button>
    <picker wx:if="{{deletedStationCandidates.length}}" range="{{deletedStationCandidates}}" bindchange="restoreStation" disabled="{{stationBusy || stationBlocked || storageBlocked}}"><view class="ui-button text-button">重新启用已删除的驿站</view></picker>
    <button hover-class="{{(stationBusy) ? 'none' : 'button-pressed'}}" hover-start-time="0" hover-stay-time="0" class="ui-button {{(stationBusy) ? 'ui-disabled' : ''}} secondary" data-tab="home" catchtap="switchTab" disabled="{{stationBusy}}">返回待取件</button>
  </view>
  <view wx:if="{{stationEditor}}" class="modal-mask" style="{{keyboardHeight ? 'bottom: ' + keyboardHeight + 'px;' : ''}}" catchtap="cancelStationEdit">
    <view class="edit-sheet" style="{{keyboardHeight ? 'max-height: calc(100vh - ' + keyboardHeight + 'px - 16px);' : ''}}" catchtap="noop">
      <view wx:if="{{stationEditor.mode === 'detail'}}">
        <view class="section-title">{{stationEditor.name}}</view>
        <view wx:if="{{stationEditor.suspicious}}" class="notice">名称可能混入通知正文，请核对后修改。包裹的原地点会保留。</view>
        <button class="ui-button secondary" data-id="{{stationEditor.id}}" bindtap="editStationName">修改名称</button>
        <view class="field-label">已确认别名</view>
        <view class="station-alias" wx:for="{{stationEditor.aliases}}" wx:key="*this" wx:for-item="alias"><text class="alias-name">{{alias}}</text><button wx:if="{{alias !== stationEditor.name}}" size="mini" class="ui-button {{(stationBusy || stationBlocked || storageBlocked) ? 'ui-disabled' : ''}} text-button" data-id="{{stationEditor.id}}" data-alias="{{alias}}" bindtap="unlinkStation" disabled="{{stationBusy || stationBlocked || storageBlocked}}">取消关联</button></view>
        <button class="ui-button {{(stationBlocked || storageBlocked) ? 'ui-disabled' : ''}} text-button" bindtap="addStationAlias" disabled="{{stationBlocked || storageBlocked}}">添加别名</button>
        <button wx:if="{{!stationEditor.confirmed && !stationEditor.suspicious}}" class="ui-button {{(stationBlocked || storageBlocked) ? 'ui-disabled' : ''}} text-button" data-id="{{stationEditor.id}}" bindtap="markStationCommon" disabled="{{stationBlocked || storageBlocked}}">确认此驿站</button>
        <picker wx:if="{{stationList.length > 1}}" range="{{stationEditor.mergeNames}}" bindchange="mergeStationFromDetail" disabled="{{stationBusy || stationBlocked || storageBlocked}}"><view class="ui-button text-button">与另一驿站合并 ›</view></picker>
        <button class="ui-button {{(stationBusy || stationBlocked || storageBlocked) ? 'ui-disabled' : ''}} danger-button" bindtap="deleteStation" disabled="{{stationBusy || stationBlocked || storageBlocked}}">删除驿站</button>
        <button class="ui-button {{(stationBusy) ? 'ui-disabled' : ''}} text-button" bindtap="cancelStationEdit" disabled="{{stationBusy}}">关闭</button>
      </view>
      <block wx:else>
      <view class="section-title">{{stationEditor.mode === 'merge' ? '统一驿站名称' : stationEditor.mode === 'alias' ? '添加已确认别名' : stationEditor.mode === 'add' ? '添加驿站' : '修改显示名称'}}</view>
      <input class="field-input" value="{{stationEditor.name}}" bindinput="stationNameInput" maxlength="100" adjust-position="{{false}}" cursor-spacing="24" placeholder="填写统一显示的驿站名" disabled="{{stationBusy}}" />
      <view class="hint">原记录地点保留</view>
      <view wx:if="{{stationError}}" class="error">{{stationError}}</view>
      <view class="actions"><button hover-class="{{(stationBusy) ? 'none' : 'button-pressed'}}" hover-start-time="0" hover-stay-time="0" class="ui-button {{(stationBusy) ? 'ui-disabled' : ''}} secondary" catchtap="cancelStationEdit" disabled="{{stationBusy}}">取消</button><button hover-class="{{(stationBusy || stationBlocked || storageBlocked) ? 'none' : 'button-pressed'}}" hover-start-time="0" hover-stay-time="0" class="ui-button {{(stationBusy || stationBlocked || storageBlocked) ? 'ui-disabled' : ''}} primary" catchtap="confirmStationEdit" disabled="{{stationBusy || stationBlocked || storageBlocked}}">{{stationEditor.mode === 'merge' ? '确认合并' : '保存'}}</button></view>
      </block>
    </view>
  </view>

  <view wx:if="{{!keyboardHeight}}" class="bottom-nav" catchtap="closeDelete">
    <button hover-class="button-pressed" hover-start-time="0" hover-stay-time="0" class="ui-button nav-item {{activeTab === 'home' ? 'nav-active' : ''}}" data-tab="home" catchtap="switchTab"><text class="nav-symbol">▤</text><text>待取件</text></button>
    <button hover-class="button-pressed" hover-start-time="0" hover-stay-time="0" class="ui-button nav-item {{activeTab === 'import' ? 'nav-active' : 'nav-import'}}" data-tab="import" catchtap="switchTab"><text class="nav-symbol">＋</text><text>导入{{validDraftCount ? ' · ' + validDraftCount : loading ? ' · 识别中' : ''}}</text></button>
    <button hover-class="button-pressed" hover-start-time="0" hover-stay-time="0" class="ui-button nav-item {{activeTab === 'history' ? 'nav-active' : ''}}" data-tab="history" catchtap="switchTab"><text class="nav-symbol">✓</text><text>历史</text></button>
  </view>
  <view wx:if="{{undoAvailable}}" class="undo-bar" catchtap="recordTap"><text>{{undoMessage}} · 5 秒内可撤销</text><button hover-class="{{(storageBlocked || importing || deleting) ? 'none' : 'button-pressed'}}" hover-start-time="0" hover-stay-time="0" class="ui-button {{(storageBlocked || importing || deleting) ? 'ui-disabled' : ''}} undo-action" size="mini" catchtap="undoDelete" disabled="{{storageBlocked || importing || deleting}}">撤销</button></view>

  </view>
  <view wx:if="{{exceptionOpen && currentException}}" class="review-screen exception-screen" catchtap="noop">
    <view class="review-header"><view class="exception-progress">{{loading ? progress : exceptionProgress}}</view></view>
    <view class="review-list-slot"><scroll-view class="review-list" scroll-y="{{true}}">
      <view class="exception-parcel">
        <scroll-view class="code-scroll" scroll-x="{{true}}"><text class="review-code">{{currentException.code || '取件码待补充'}}</text></scroll-view>
        <view wx:if="{{currentException.station}}" class="exception-station">{{currentException.station}}</view>
        <view class="review-reason">{{currentException.message}}</view>
        <view wx:if="{{currentException.conflictText}}" class="hint">请核对：{{currentException.conflictText}}</view>
        <view class="exception-sources">
          <view wx:for="{{currentException.sources}}" wx:key="imageId" wx:for-item="source" class="exception-source">
            <view class="hint">{{source.label}}</view>
            <image wx:if="{{source.path}}" class="exception-thumbnail" src="{{source.path}}" mode="aspectFit" data-batch-id="{{source.batchId}}" data-image-index="{{source.imageIndex}}" bindtap="previewResultImage" binderror="sourceImageError" aria-label="放大{{source.label}}" />
            <view wx:else class="source-expired"><text>原图未保留或已失效</text><button class="ui-button {{(choosing || loading) ? 'ui-disabled' : ''}} text-button" data-batch-id="{{source.batchId}}" data-image-index="{{source.imageIndex}}" bindtap="selectSourceImage" disabled="{{choosing || loading}}">{{source.needsRecognition ? '选图重新识别' : '重新选择原图'}}</button></view>
          </view>
        </view>
        <view wx:if="{{currentException.matches.length}}" class="existing-evidence"><view class="field-label">已有记录</view><view wx:for="{{currentException.matches}}" wx:key="id" wx:for-item="match" class="hint">{{match.code}} · {{match.station}} · {{match.taken ? '已取件' : '待取件'}}</view></view>
        <view wx:if="{{currentException.sources.length}}" class="text-action" bindtap="toggleExceptionEvidence" role="button">{{currentException.evidenceOpen ? '收起识别依据' : '查看识别依据'}}</view>
        <view wx:if="{{currentException.evidenceOpen}}" class="evidence-details"><view wx:for="{{currentException.matches}}" wx:key="id" wx:for-item="match"><view class="field-label">已有记录</view><view wx:if="{{match.pickupAddress}}" class="hint">详细地址：{{match.pickupAddress}}</view><view wx:if="{{match.carrier}}" class="hint">快递公司：{{match.carrier}}</view><view wx:if="{{match.waybillNumber}}" class="hint">运单号：{{match.waybillNumber}}</view></view><view wx:for="{{currentException.sources}}" wx:key="imageId" wx:for-item="source"><view class="hint">{{source.label}}：{{source.fields || '需要人工核对'}}</view><view wx:for="{{source.values}}" wx:key="*this" class="hint">{{item}}</view></view></view>

      </view>
    </scroll-view></view>
    <view class="review-footer exception-actions">
      <view wx:if="{{storageError}}" class="error">{{storageError}}</view>
      <view wx:if="{{currentException.failed && !loading}}" class="error">1 张识别失败</view>
      <block wx:if="{{currentException.needsCode}}">
        <button class="ui-button {{(loading || choosing || storageBlocked) ? 'ui-disabled' : ''}} primary" hover-class="button-pressed" data-batch-id="{{currentException.batchId}}" data-image-index="{{currentException.imageIndex}}" bindtap="retryException" disabled="{{loading || choosing || storageBlocked}}">{{currentException.path ? '重试识别' : '选图重试识别'}}</button>
        <button class="ui-button {{(loading || storageBlocked) ? 'ui-disabled' : ''}} secondary" hover-class="button-pressed" data-id="{{currentException.id}}" bindtap="editException" disabled="{{loading || storageBlocked}}">手动补充</button>
        <button class="ui-button {{(loading || storageBlocked) ? 'ui-disabled' : ''}} secondary" hover-class="button-pressed" data-id="{{currentException.id}}" data-action="skip" bindtap="chooseException" disabled="{{loading || storageBlocked}}">跳过</button>
      </block>
      <block wx:else>
        <button wx:if="{{currentException.locationOnly || currentException.options.length}}" class="ui-button {{(choosing || loading || storageBlocked) ? 'ui-disabled' : ''}} primary" hover-class="button-pressed" data-id="{{currentException.id}}" bindtap="chooseExceptionStation" disabled="{{choosing || loading || storageBlocked}}">选择驿站</button>
        <button wx:if="{{currentException.allowNew}}" class="ui-button {{(loading || storageBlocked) ? 'ui-disabled' : ''}} {{currentException.locationOnly || currentException.options.length ? 'secondary' : 'primary'}}" hover-class="button-pressed" data-id="{{currentException.id}}" data-action="new" bindtap="chooseException" disabled="{{loading || storageBlocked}}">{{currentException.locationOnly ? '先加入待取' : currentException.reason === 'uncertain_code' ? '号码无误，加入待取' : '是新包裹，加入待取'}}</button>
        <button wx:if="{{currentException.reason === 'uncertain_code'}}" class="ui-button {{(loading || storageBlocked) ? 'ui-disabled' : ''}} secondary" hover-class="button-pressed" data-id="{{currentException.id}}" bindtap="editException" disabled="{{loading || storageBlocked}}">修改取件码</button>
        <button wx:if="{{!currentException.locationOnly}}" class="ui-button {{(loading || storageBlocked) ? 'ui-disabled' : ''}} secondary" hover-class="button-pressed" data-id="{{currentException.id}}" data-action="skip" bindtap="chooseException" disabled="{{loading || storageBlocked}}">{{currentException.reason === 'historical_code' ? '已经取过，跳过' : currentException.allowNew ? '无需领取，跳过' : '保留已有记录'}}</button>
      </block>
      <button class="ui-button {{(loading) ? 'ui-disabled' : ''}} text-button" hover-class="button-pressed" bindtap="deferException" disabled="{{loading}}">稍后处理</button>
    </view>
  </view>
  <view wx:if="{{reviewOpen}}" class="review-screen" catchtap="noop">
      <view class="review-header"><view class="section-title">核对重复快递</view><view class="hint">仅补全空缺信息，保留原记录状态。确认后统一保存。</view></view>
      <view class="review-list-slot"><scroll-view class="review-list" scroll-y="{{true}}">
        <view wx:for="{{reviewItems}}" wx:key="id" wx:for-item="entry" class="review-item">
          <scroll-view class="code-scroll" scroll-x="{{true}}"><text class="review-code">{{entry.code}}</text></scroll-view><view class="hint">本次地点：{{entry.station}}</view><view wx:if="{{entry.pickupAddress}}" class="hint">本次地址：{{entry.pickupAddress}}</view><view wx:if="{{entry.carrier}}" class="hint">本次公司：{{entry.carrier}}</view>
          <view class="review-reason">{{entry.reason}}</view><view wx:if="{{entry.batchReview}}" class="hint"><text wx:for="{{entry.sourceIndices}}" wx:key="*this">截图 {{item + 1}} </text></view>
          <view wx:for="{{entry.matches}}" wx:key="id" wx:for-item="match" class="match-info">
            <view class="hint">原记录（{{match.taken ? '已取件' : '待取件'}}）：{{match.code}}</view><view wx:if="{{match.pickupAddress}}" class="hint">原地址：{{match.pickupAddress}}</view><view class="match-station">{{match.station}}{{match.carrier ? ' · ' + match.carrier : ''}}</view>
            <button hover-class="button-pressed" hover-start-time="0" hover-stay-time="0" wx:if="{{match.canUpdate}}" class="ui-button review-option {{entry.action === 'update' && entry.targetId === match.id ? 'option-selected' : ''}}" data-id="{{entry.id}}" data-action="update" data-target-id="{{match.id}}" catchtap="chooseImportAction">{{entry.action === 'update' && entry.targetId === match.id ? '✓ ' : ''}}更新此记录{{entry.recommended ? '（推荐）' : ''}}<text class="option-detail">补全{{match.additions}}</text></button>
          </view>
          <button hover-class="button-pressed" hover-start-time="0" hover-stay-time="0" class="ui-button review-option {{entry.action === 'skip' ? 'option-selected' : ''}}" data-id="{{entry.id}}" data-action="skip" catchtap="chooseImportAction">{{entry.action === 'skip' ? '✓ ' : ''}}保留原记录，跳过本次</button>
          <button hover-class="button-pressed" hover-start-time="0" hover-stay-time="0" wx:if="{{entry.allowNew}}" class="ui-button review-option {{entry.action === 'new' ? 'option-selected' : ''}}" data-id="{{entry.id}}" data-action="new" catchtap="chooseImportAction">{{entry.action === 'new' ? '✓ ' : ''}}{{entry.batchReview && !entry.matches.length ? '核对原图后保留此记录' : '确认是另一件包裹，新增'}}</button>
          <view wx:else class="hint">运单号相同，不能重复新增。</view>
        </view>
      </scroll-view></view>
      <view class="review-footer"><view class="review-summary">{{reviewSummary}}</view><view class="actions"><button hover-class="button-pressed" hover-start-time="0" hover-stay-time="0" class="ui-button secondary" catchtap="cancelImportReview">返回核对</button><button hover-class="button-pressed" hover-start-time="0" hover-stay-time="0" class="ui-button primary" catchtap="finishImportReview">按以上选择导入</button></view></view>
  </view>
  <view wx:if="{{editing}}" class="modal-mask" style="{{keyboardHeight ? 'bottom: ' + keyboardHeight + 'px;' : ''}}" catchtap="cancelEdit">
    <view class="edit-sheet" style="{{keyboardHeight ? 'max-height: calc(100vh - ' + keyboardHeight + 'px - 16px);' : ''}}" catchtap="noop">
      <view class="section-title">核对并修改</view>
      <text class="field-label">取件码</text><input class="field-input" value="{{editing.code}}" bindinput="editCode" placeholder="填写完整取件码" maxlength="32" adjust-position="{{false}}" cursor-spacing="24" />
      <text class="field-label">取件地点</text><textarea class="station-input" value="{{editing.station}}" bindinput="editStation" placeholder="填写驿站名称" maxlength="100" auto-height="{{true}}" adjust-position="{{false}}" cursor-spacing="24" />
      <checkbox-group wx:if="{{editing.originalPickupLocation && editing.originalPickupLocation !== editing.station && editing.originalPickupLocation !== '待确认地点'}}" bindchange="rememberLocationChange"><label><checkbox value="remember" checked="{{editing.rememberLocation}}" />记住「{{editing.originalPickupLocation}}」与此驿站的关联</label></checkbox-group>
      <text class="field-label">详细取件地址（选填）</text><textarea class="station-input" value="{{editing.pickupAddress}}" bindinput="editPickupAddress" maxlength="100" auto-height="{{true}}" adjust-position="{{false}}" cursor-spacing="24" />
      <text class="field-label">快递公司（选填）</text><input class="field-input" value="{{editing.carrier}}" bindinput="editCarrier" placeholder="如：中通快递" maxlength="40" adjust-position="{{false}}" cursor-spacing="24" />
      <view wx:if="{{editError}}" class="error">{{editError}}</view>
      <view class="actions"><button hover-class="button-pressed" hover-start-time="0" hover-stay-time="0" class="ui-button secondary" bindtap="cancelEdit">取消</button><button hover-class="button-pressed" hover-start-time="0" hover-stay-time="0" class="ui-button primary" bindtap="saveEdit">{{editing.exception ? '加入待取' : '保存修改'}}</button></view>
    </view>
  </view>
</view>
