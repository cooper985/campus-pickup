<page-meta page-style="{{(dragId || reviewOpen || editing || stationEditor) ? 'overflow: hidden;' : ''}}" />
<view class="pickup {{reduceMotion ? 'reduce-motion' : ''}}" bindtap="closeDelete">
  <view hidden="{{reviewOpen}}">
  <view wx:if="{{storageError}}" class="error" role="alert">{{storageError}}</view>
  <view wx:if="{{error && activeTab !== 'import' && errorScope !== 'import'}}" class="error" role="alert">{{error}}</view>
  <view wx:if="{{stationError}}" class="error" role="alert">{{stationError}}</view>
  <view class="page-panel" wx:if="{{activeTab === 'home'}}">
    <view wx:if="{{importFeedback}}" class="import-feedback" role="status">{{importFeedback}}</view>
    <view class="page-header"><view class="heading">待取件 <text class="count">{{remaining}}</text> 件</view><button hover-class="button-pressed" hover-start-time="0" hover-stay-time="0" class="ui-button text-button manage-stations" catchtap="openStations">管理驿站</button></view>
    <view wx:if="{{!remaining}}" class="empty">暂无待取快递</view>
    <view wx:for="{{visiblePendingGroups}}" wx:key="id" wx:for-item="group" class="station-exit {{group.leaving ? 'station-leaving' : ''}}"><view class="station-exit-inner"><view class="card station-card home-station {{group.id !== '__unknown' ? 'sortable-station' : ''}} {{dragId === group.id ? 'station-lifted' : ''}} {{dragId ? 'station-sorting' : ''}}" style="{{group.dragStyle}}">
      <view class="station-header" data-station="{{group.station}}" catchtap="toggleGroup" role="button" aria-label="{{group.collapsed ? '展开' : '收起'}}{{group.station}}"><view wx:if="{{group.id !== '__unknown' && locationCount > 1}}" class="drag-handle" data-id="{{group.id}}" bindtouchstart="stationTouchStart" bindtouchmove="moveStationDrag" bindtouchend="finishStationDrag" bindtouchcancel="cancelStationDrag" catchlongpress="beginStationDrag" catchtap="noop" role="button" aria-label="长按拖动{{group.station}}排序">⠿</view><view class="station-mark tone-{{group.tone}}">{{group.id === '__unknown' ? '!' : '▤'}}</view><view class="station-name {{group.station === '待确认地点' ? 'review' : ''}}">{{group.station}}</view><text class="station-count">{{group.items.length}} 件　{{group.collapsed ? '＋' : '−'}}</text></view>

      <view class="group-content {{group.collapsed ? 'is-collapsed' : ''}}" aria-hidden="{{group.collapsed}}"><view class="group-inner">
        <view wx:for="{{group.items}}" wx:key="id" class="exit-row {{item.leaving ? 'row-leaving' : ''}}"><view class="exit-inner"><view class="parcel-row">
          <view class="parcel-main"><view wx:if="{{item.pickupAddress}}" class="hint">取件地址：{{item.pickupAddress}}</view><text class="pickup-code copy-code" data-id="{{item.id}}" catchtap="copyCode" role="button" aria-label="复制取件码 {{item.code}}">{{item.code}}</text><view class="record-meta"><text wx:if="{{item.carrier}}">{{item.carrier}} · </text><view hover-class="button-pressed" hover-start-time="0" hover-stay-time="0" class="text-action" data-id="{{item.id}}" catchtap="editRecord" role="button">{{group.station === '待确认地点' ? '补充地点' : '修改'}}</view></view></view>
          <button hover-class="{{(importing || deleting || storageBlocked || dragId) ? 'none' : 'button-pressed'}}" hover-start-time="0" hover-stay-time="0" size="mini" class="ui-button {{(importing || deleting || storageBlocked) ? 'ui-disabled' : ''}} take-button" data-id="{{item.id}}" catchtap="toggleTaken" disabled="{{importing || deleting || storageBlocked || dragId}}">我已取件</button>
        </view></view></view>
      <view wx:if="{{group.items.length > 1}}" class="batch-row"><button hover-class="{{(importing || deleting || storageBlocked || dragId) ? 'none' : 'button-pressed'}}" hover-start-time="0" hover-stay-time="0" size="mini" class="ui-button {{(importing || deleting || storageBlocked || dragId) ? 'ui-disabled' : ''}} secondary batch-take-button" data-id="{{group.id}}" catchtap="takeStation" disabled="{{importing || deleting || storageBlocked || dragId}}">全部标记已取</button></view>
      </view></view>
    </view></view></view>
  </view>

  <view class="page-panel" wx:if="{{activeTab === 'import'}}">
    <view class="heading">{{notificationOpen ? '粘贴通知' : '导入快递'}}</view>
    <view wx:if="{{notificationOpen}}" class="notification-composer">
      <textarea class="notification-input" value="{{notificationText}}" bindinput="notificationInput" placeholder="请粘贴完整的快递取件通知" maxlength="20000" cursor-spacing="24" disabled="{{choosing || importing}}" adjust-position="{{true}}" aria-label="完整快递取件通知" />
      <view wx:if="{{error}}" class="error" role="alert">{{error}}</view>
      <button hover-class="{{(choosing || importing) ? 'none' : 'button-pressed'}}" hover-start-time="0" hover-stay-time="0" wx:if="{{notificationText}}" class="ui-button {{(choosing || importing) ? 'ui-disabled' : ''}} text-button clear-text" bindtap="clearNotificationText" disabled="{{choosing || importing}}">清空文字</button>
      <button hover-class="{{(!notificationText || choosing || importing) ? 'none' : 'button-pressed'}}" hover-start-time="0" hover-stay-time="0" class="ui-button {{(!notificationText || choosing || importing) ? 'ui-disabled' : ''}} primary full-button" bindtap="recognizeNotification" disabled="{{!notificationText || choosing || importing}}" loading="{{choosing}}">识别通知</button>
      <button hover-class="{{(choosing || importing) ? 'none' : 'button-pressed'}}" hover-start-time="0" hover-stay-time="0" class="ui-button {{(choosing || importing) ? 'ui-disabled' : ''}} text-button" bindtap="cancelNotification" disabled="{{choosing || importing}}">取消</button>
    </view>
    <block wx:else>
      <view class="import-sources">
        <button hover-class="{{(loading || choosing || importing) ? 'none' : 'button-pressed'}}" hover-start-time="0" hover-stay-time="0" class="ui-button {{(loading || choosing || importing) ? 'ui-disabled' : ''}} primary import-source" bindtap="chooseImage" disabled="{{loading || choosing || importing}}" loading="{{choosing}}"><text class="source-symbol">▧</text><text>{{images.length ? '重新选择截图' : '从相册选择截图'}}</text></button>
        <button hover-class="{{(loading || choosing || importing) ? 'none' : 'button-pressed'}}" hover-start-time="0" hover-stay-time="0" class="ui-button {{(loading || choosing || importing) ? 'ui-disabled' : ''}} secondary import-source" bindtap="openNotification" disabled="{{loading || choosing || importing}}"><text class="source-symbol">≡</text><text>粘贴通知</text></button>
      </view>
      <view wx:if="{{error}}" class="error" role="alert">{{error}}</view>
      <view wx:if="{{loading}}" class="progress-line"><text>{{progress}}</text><button hover-class="button-pressed" hover-start-time="0" hover-stay-time="0" size="mini" class="ui-button text-button" bindtap="cancelRecognition">停止本批</button></view>
      <view wx:if="{{visibleDraftGroups.length}}" class="draft-section">
        <view class="result-heading"><view class="section-heading">核对结果 <text class="hint inline">{{validDraftCount}} 件</text></view><button hover-class="{{(importing) ? 'none' : 'button-pressed'}}" hover-start-time="0" hover-stay-time="0" wx:if="{{notificationText}}" size="mini" class="ui-button {{(importing) ? 'ui-disabled' : ''}} text-button" bindtap="openNotification" disabled="{{importing}}">修改文字</button></view>
        <view wx:if="{{mock}}" class="notice">模拟示例，与截图内容无关。</view>
        <view wx:for="{{visibleDraftGroups}}" wx:key="station" wx:for-item="group" class="station-exit {{group.leaving ? 'station-leaving' : ''}}"><view class="station-exit-inner"><view class="card station-card">
          <view class="station-header"><view class="station-name {{group.station === '待确认地点' ? 'review' : ''}}">{{group.station}}</view><text class="station-count">{{group.validCount}} 件</text></view>
          <view wx:for="{{group.items}}" wx:key="id" class="exit-row {{item.leaving ? 'row-leaving' : ''}}"><view class="exit-inner"><view class="parcel-row">
            <view class="parcel-main"><view wx:if="{{item.pickupAddress}}" class="hint">取件地址：{{item.pickupAddress}}</view><text class="pickup-code" user-select="{{true}}">{{item.code || '号码缺失'}}</text><view wx:if="{{item.carrier}}" class="record-meta">{{item.carrier}}</view></view>
            <view class="draft-actions"><button hover-class="{{(importing) ? 'none' : 'button-pressed'}}" hover-start-time="0" hover-stay-time="0" size="mini" class="ui-button {{(importing) ? 'ui-disabled' : ''}} secondary" data-id="{{item.id}}" bindtap="editRecord" disabled="{{importing}}">修改</button><button hover-class="{{(importing) ? 'none' : 'button-pressed'}}" hover-start-time="0" hover-stay-time="0" size="mini" class="ui-button {{(importing) ? 'ui-disabled' : ''}} text-button" data-id="{{item.id}}" bindtap="removeDraft" disabled="{{importing}}">移除</button></view>
          </view></view></view>
        </view></view></view>
      </view>
      <view wx:if="{{drafts.length || results.length || loading || completed}}" class="import-result-actions">
        <button hover-class="{{(!validDraftCount || loading || importing || deleting || storageBlocked) ? 'none' : 'button-pressed'}}" hover-start-time="0" hover-stay-time="0" class="ui-button {{(!validDraftCount || loading || importing || deleting || storageBlocked) ? 'ui-disabled' : ''}} primary full-button" bindtap="confirmImport" disabled="{{!validDraftCount || loading || importing || deleting || storageBlocked}}" loading="{{importing}}">确认导入 {{validDraftCount}} 件</button>
        <view class="session-actions"><button hover-class="{{(importing) ? 'none' : 'button-pressed'}}" hover-start-time="0" hover-stay-time="0" class="ui-button {{(importing) ? 'ui-disabled' : ''}} text-button" bindtap="clearImportResults" disabled="{{importing}}">清空本次结果</button><button hover-class="{{(importing) ? 'none' : 'button-pressed'}}" hover-start-time="0" hover-stay-time="0" class="ui-button {{(importing) ? 'ui-disabled' : ''}} text-button" bindtap="cancelImport" disabled="{{importing}}">取消本次导入</button></view>
      </view>
      <view wx:if="{{results.length}}" class="section-heading small-heading">截图 · {{images.length}} 张</view>
      <view wx:for="{{results}}" wx:key="taskId" class="card image-result">
        <image class="result-thumbnail" src="{{images[item.index - 1]}}" mode="aspectFill" data-index="{{item.index - 1}}" bindtap="previewImage" />
        <view class="result-copy"><view class="result-label">截图 {{item.index}}</view><view class="result-status {{item.count ? 'success' : ''}}">{{item.error || item.message}}</view><view wx:if="{{item.retained}}" class="hint">上次成功结果已保留</view><view wx:if="{{item.uncertainCount}}" class="hint">部分内容待核对</view></view>
        <button hover-class="button-pressed" hover-start-time="0" hover-stay-time="0" wx:if="{{item.state === 'queued' || item.state === 'running'}}" size="mini" class="ui-button text-button" data-task-id="{{item.taskId}}" bindtap="skipImage">跳过</button>
        <button hover-class="{{(importing) ? 'none' : 'button-pressed'}}" hover-start-time="0" hover-stay-time="0" wx:if="{{item.retryable}}" size="mini" class="ui-button {{(importing) ? 'ui-disabled' : ''}} secondary" data-task-id="{{item.taskId}}" bindtap="retryImage" disabled="{{importing}}">重试</button>
      </view>
    </block>
    <button hover-class="button-pressed" hover-start-time="0" hover-stay-time="0" class="ui-button text-button privacy-link" bindtap="showImportPrivacy">隐私说明</button>
  </view>

  <view class="page-panel" wx:if="{{activeTab === 'history'}}">
    <view wx:if="{{!history.length}}" class="empty">暂无已取件记录</view>
    <view class="card history-card" wx:if="{{visibleHistory.length}}">
      <view wx:for="{{visibleHistory}}" wx:key="id" class="swipe-shell exit-row {{item.leaving ? 'row-leaving' : ''}}" data-id="{{item.id}}" bindtouchstart="touchStart" bindtouchmove="touchMove" bindtouchend="touchEnd" bindtouchcancel="touchCancel" catchtap="recordTap">
        <view class="exit-inner"><view wx:if="{{openDeleteId === item.id || swipeId === item.id}}" class="delete-button" hover-class="button-pressed" hover-start-time="0" hover-stay-time="0" role="button" aria-label="删除已取件记录" data-id="{{item.id}}" catchtap="deleteRecord"><text class="delete-label">删除</text></view>
        <view class="swipe-content {{openDeleteId === item.id ? 'swipe-open' : ''}}" style="{{swipeId === item.id ? swipeStyle : ''}}">
          <view class="history-top"><text class="pickup-code" user-select="{{true}}">{{item.code}}</text><text class="history-state">已取件</text></view>
          <view class="history-station">{{item.station}}</view><view wx:if="{{item.pickupAddress}}" class="hint">取件地址：{{item.pickupAddress}}</view>
          <view class="history-bottom"><text class="hint">{{item.takenTimeLabel}}{{item.carrier ? ' · ' + item.carrier : ''}}</text><button hover-class="{{(importing || deleting || storageBlocked) ? 'none' : 'button-pressed'}}" hover-start-time="0" hover-stay-time="0" size="mini" class="ui-button {{(importing || deleting || storageBlocked) ? 'ui-disabled' : ''}} secondary" data-id="{{item.id}}" catchtap="toggleTaken" disabled="{{importing || deleting || storageBlocked}}">恢复待取</button></view>
        </view></view>
      </view>
    </view>
  </view>

  <view class="page-panel" wx:if="{{activeTab === 'stations'}}">
    <view class="heading">管理驿站</view>
    <view class="subtitle">选择两个驿站可合并</view>
    <view wx:if="{{!stationList.length}}" class="empty">导入快递后，这里会列出已知取件地点。</view>
    <view wx:for="{{stationSuggestions}}" wx:key="*this" class="notice">可能同站：{{item}}</view>
    <view wx:for="{{stationList}}" wx:key="id" wx:for-item="station" wx:for-index="stationIndex" class="card station-setting">
      <view class="station-setting-top">
        <button hover-class="{{(stationBusy || stationBlocked || storageBlocked) ? 'none' : 'button-pressed'}}" hover-start-time="0" hover-stay-time="0" size="mini" class="ui-button {{(stationBusy || stationBlocked || storageBlocked) ? 'ui-disabled' : ''}} station-select {{(stationSelection[0] === station.id || stationSelection[1] === station.id) ? 'option-selected' : 'secondary'}}" disabled="{{stationBusy || stationBlocked || storageBlocked}}" data-id="{{station.id}}" catchtap="selectStation" aria-label="选择{{station.name}}">{{(stationSelection[0] === station.id || stationSelection[1] === station.id) ? '✓ 已选' : '选择'}}</button>
        <view class="parcel-main"><view class="station-name">{{station.name}}</view><view class="hint">{{station.count}} 件待取</view></view>
        <button hover-class="{{(stationBusy || stationBlocked || storageBlocked) ? 'none' : 'button-pressed'}}" hover-start-time="0" hover-stay-time="0" size="mini" class="ui-button {{(stationBusy || stationBlocked || storageBlocked) ? 'ui-disabled' : ''}} text-button" data-id="{{station.id}}" catchtap="editStationName" disabled="{{stationBusy || stationBlocked || storageBlocked}}">修改名称</button>
      </view>
      <view wx:if="{{station.aliases.length > 1 || alias !== station.name}}" class="station-alias" wx:for="{{station.aliases}}" wx:key="*this" wx:for-item="alias"><text class="alias-name">原地点：{{alias}}</text><button hover-class="button-pressed" hover-start-time="0" hover-stay-time="0" wx:if="{{station.aliases.length > 1}}" size="mini" class="ui-button text-button" data-id="{{station.id}}" data-alias="{{alias}}" catchtap="unlinkStation" disabled="{{stationBusy || stationBlocked || storageBlocked}}">取消关联</button></view>
      <view class="station-order"><button hover-class="{{(stationIndex === 0 || stationBusy || stationBlocked || storageBlocked) ? 'none' : 'button-pressed'}}" hover-start-time="0" hover-stay-time="0" size="mini" class="ui-button {{(stationIndex === 0 || stationBusy || stationBlocked || storageBlocked) ? 'ui-disabled' : ''}} secondary" data-id="{{station.id}}" data-direction="-1" catchtap="moveStation" disabled="{{stationIndex === 0 || stationBusy || stationBlocked || storageBlocked}}">↑ 上移</button><button hover-class="{{(stationIndex === stationList.length - 1 || stationBusy || stationBlocked || storageBlocked) ? 'none' : 'button-pressed'}}" hover-start-time="0" hover-stay-time="0" size="mini" class="ui-button {{(stationIndex === stationList.length - 1 || stationBusy || stationBlocked || storageBlocked) ? 'ui-disabled' : ''}} secondary" data-id="{{station.id}}" data-direction="1" catchtap="moveStation" disabled="{{stationIndex === stationList.length - 1 || stationBusy || stationBlocked || storageBlocked}}">↓ 下移</button></view>
    </view>
    <button hover-class="button-pressed" hover-start-time="0" hover-stay-time="0" wx:if="{{stationList.length > 1}}" class="ui-button primary" catchtap="beginStationMerge" disabled="{{stationSelection.length !== 2 || stationBusy || stationBlocked || storageBlocked}}">合并两个驿站（{{stationSelection.length}}/2）</button>
    <button hover-class="{{(stationBusy) ? 'none' : 'button-pressed'}}" hover-start-time="0" hover-stay-time="0" class="ui-button {{(stationBusy) ? 'ui-disabled' : ''}} secondary" data-tab="home" catchtap="switchTab" disabled="{{stationBusy}}">返回待取件</button>
  </view>
  <view wx:if="{{stationEditor}}" class="modal-mask" catchtap="cancelStationEdit">
    <view class="edit-sheet" catchtap="noop">
      <view class="section-title">{{stationEditor.mode === 'merge' ? '统一驿站名称' : '修改显示名称'}}</view>
      <input class="field-input" value="{{stationEditor.name}}" bindinput="stationNameInput" maxlength="100" placeholder="填写统一显示的驿站名" disabled="{{stationBusy}}" />
      <view class="hint">原记录地点保留</view>
      <view wx:if="{{stationError}}" class="error">{{stationError}}</view>
      <view class="actions"><button hover-class="{{(stationBusy) ? 'none' : 'button-pressed'}}" hover-start-time="0" hover-stay-time="0" class="ui-button {{(stationBusy) ? 'ui-disabled' : ''}} secondary" catchtap="cancelStationEdit" disabled="{{stationBusy}}">取消</button><button hover-class="{{(stationBusy || stationBlocked || storageBlocked) ? 'none' : 'button-pressed'}}" hover-start-time="0" hover-stay-time="0" class="ui-button {{(stationBusy || stationBlocked || storageBlocked) ? 'ui-disabled' : ''}} primary" catchtap="confirmStationEdit" disabled="{{stationBusy || stationBlocked || storageBlocked}}">{{stationEditor.mode === 'merge' ? '确认合并' : '保存名称'}}</button></view>
    </view>
  </view>

  <view class="bottom-nav" catchtap="closeDelete">
    <button hover-class="button-pressed" hover-start-time="0" hover-stay-time="0" class="ui-button nav-item {{activeTab === 'home' ? 'nav-active' : ''}}" data-tab="home" catchtap="switchTab"><text class="nav-symbol">▤</text><text>待取件</text></button>
    <button hover-class="button-pressed" hover-start-time="0" hover-stay-time="0" class="ui-button nav-item nav-import {{activeTab === 'import' ? 'nav-active' : ''}}" data-tab="import" catchtap="switchTab"><text class="nav-symbol">＋</text><text>导入{{validDraftCount ? ' · ' + validDraftCount : loading ? ' · 识别中' : ''}}</text></button>
    <button hover-class="button-pressed" hover-start-time="0" hover-stay-time="0" class="ui-button nav-item {{activeTab === 'history' ? 'nav-active' : ''}}" data-tab="history" catchtap="switchTab"><text class="nav-symbol">✓</text><text>历史</text></button>
  </view>
  <view wx:if="{{undoAvailable}}" class="undo-bar" catchtap="recordTap"><text>{{undoMessage}} · 5 秒内可撤销</text><button hover-class="{{(storageBlocked || importing || deleting) ? 'none' : 'button-pressed'}}" hover-start-time="0" hover-stay-time="0" class="ui-button {{(storageBlocked || importing || deleting) ? 'ui-disabled' : ''}} undo-action" size="mini" catchtap="undoDelete" disabled="{{storageBlocked || importing || deleting}}">撤销</button></view>
  <view wx:if="{{editing}}" class="modal-mask" catchtap="cancelEdit">
    <view class="edit-sheet" catchtap="noop">
      <view class="section-title">核对并修改</view>
      <text class="field-label">取件码</text><input class="field-input" value="{{editing.code}}" bindinput="editCode" placeholder="填写完整取件码" maxlength="32" adjust-position="{{true}}" />
      <text class="field-label">取件地点</text><textarea class="station-input" value="{{editing.station}}" bindinput="editStation" placeholder="填写驿站名称" maxlength="100" auto-height="{{true}}" adjust-position="{{true}}" />
      <text class="field-label">详细取件地址（选填）</text><textarea class="station-input" value="{{editing.pickupAddress}}" bindinput="editPickupAddress" maxlength="100" auto-height="{{true}}" adjust-position="{{true}}" />
      <text class="field-label">快递公司（选填）</text><input class="field-input" value="{{editing.carrier}}" bindinput="editCarrier" placeholder="如：中通快递" maxlength="40" adjust-position="{{true}}" />
      <view wx:if="{{editError}}" class="error">{{editError}}</view>
      <view class="actions"><button hover-class="button-pressed" hover-start-time="0" hover-stay-time="0" class="ui-button secondary" bindtap="cancelEdit">取消</button><button hover-class="button-pressed" hover-start-time="0" hover-stay-time="0" class="ui-button primary" bindtap="saveEdit">保存修改</button></view>
    </view>
  </view>
  </view>
  <view wx:if="{{reviewOpen}}" class="review-screen" catchtap="noop">
      <view class="review-header"><view class="section-title">核对重复快递</view><view class="hint">仅补全空缺信息，保留原记录状态。确认后统一保存。</view></view>
      <view class="review-list-slot"><scroll-view class="review-list" scroll-y="{{true}}">
        <view wx:for="{{reviewItems}}" wx:key="id" wx:for-item="entry" class="review-item">
          <view class="review-code">{{entry.code}}</view><view class="hint">本次地点：{{entry.station}}</view><view wx:if="{{entry.pickupAddress}}" class="hint">本次地址：{{entry.pickupAddress}}</view><view wx:if="{{entry.carrier}}" class="hint">本次公司：{{entry.carrier}}</view>
          <view class="review-reason">{{entry.reason}}</view><view wx:if="{{entry.batchReview}}" class="hint"><text wx:for="{{entry.sourceIndices}}" wx:key="*this">截图 {{item + 1}} </text></view>
          <view wx:for="{{entry.matches}}" wx:key="id" wx:for-item="match" class="match-info">
            <view class="hint">原记录（{{match.taken ? '已取件' : '待取件'}}）：{{match.code}}</view><view wx:if="{{match.pickupAddress}}" class="hint">原地址：{{match.pickupAddress}}</view><view class="match-station">{{match.station}}{{match.carrier ? ' · ' + match.carrier : ''}}</view>
            <button hover-class="button-pressed" hover-start-time="0" hover-stay-time="0" wx:if="{{match.canUpdate}}" class="ui-button review-option {{entry.action === 'update' && entry.targetId === match.id ? 'option-selected' : ''}}" data-id="{{entry.id}}" data-action="update" data-target-id="{{match.id}}" catchtap="chooseImportAction">{{entry.action === 'update' && entry.targetId === match.id ? '✓ ' : ''}}更新此记录{{entry.recommended ? '（推荐）' : ''}}<text class="option-detail">补全{{match.additions}}</text></button>
          </view>
          <button hover-class="button-pressed" hover-start-time="0" hover-stay-time="0" class="ui-button review-option {{entry.action === 'skip' ? 'option-selected' : ''}}" data-id="{{entry.id}}" data-action="skip" catchtap="chooseImportAction">{{entry.action === 'skip' ? '✓ ' : ''}}保留原记录，跳过本次</button>
          <button hover-class="button-pressed" hover-start-time="0" hover-stay-time="0" wx:if="{{entry.allowNew}}" class="ui-button review-option {{entry.action === 'new' ? 'option-selected' : ''}}" data-id="{{entry.id}}" data-action="new" catchtap="chooseImportAction">{{entry.action === 'new' ? '✓ ' : ''}}{{entry.batchReview && !entry.matches.length ? '核对原图后保留此记录' : '确认是另一件包裹，新增'}}</button>
          <view wx:else class="hint">运单号相同，不能重复新增。</view>
        </view>
      </scroll-view></view>
      <view class="review-footer"><view class="review-summary">{{reviewSummary}}</view><view class="actions"><button hover-class="button-pressed" hover-start-time="0" hover-stay-time="0" class="ui-button secondary" catchtap="cancelImportReview">返回核对</button><button hover-class="button-pressed" hover-start-time="0" hover-stay-time="0" class="ui-button primary" catchtap="finishImportReview">按以上选择导入</button></view></view>
  </view>
</view>
