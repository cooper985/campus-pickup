<view class="pickup" bindtap="closeDelete">
  <view class="eyebrow">校园生活 · 取件更轻松</view>
  <view class="heading">今天的快递，一站站取</view>
  <view class="intro">一次选择最多 9 张取件截图，识别后按地点整理。</view>
  <view class="notice">截图会交由腾讯云识别，请核对后再导入。取件记录只保存在本机，清理小程序数据会丢失记录。</view>
  <view wx:if="{{storageError}}" class="error" role="alert">{{storageError}}</view>
  <view class="card">
    <view class="section-title">01　选择截图 · {{images.length}} 张</view>
    <view class="thumbnails" wx:if="{{images.length}}">
      <image wx:for="{{images}}" wx:key="*this" class="thumbnail" src="{{item}}" mode="aspectFit" data-index="{{index}}" bindtap="previewImage" />
    </view>
    <view wx:else class="placeholder">还没有选择截图<text class="hint">单张不超过 5 MB</text></view>
    <button class="secondary" bindtap="chooseImage" disabled="{{loading || choosing || importing}}">{{images.length ? '重新选择截图' : '从相册选择截图'}}</button>
    <view class="hint" wx:if="{{images.length}}">点击缩略图可查看原图</view>
  </view>
  <button class="primary" bindtap="recognizeCloud" disabled="{{!images.length || loading || choosing || importing}}" loading="{{loading}}">{{loading ? progress : '云端识别所选截图'}}</button>
  <view wx:if="{{loading}}" class="actions"><button bindtap="cancelRecognition">取消本批识别</button></view>
  <view wx:if="{{loading}}" class="hint">识别结果会逐张显示，已完成的快递可以先导入。</view>
  <view wx:if="{{error}}" class="error" role="alert">{{error}}</view>
  <view wx:for="{{results}}" wx:key="taskId" class="card image-result">
    <view class="result-summary"><text>截图 {{item.index}}</text><text class="result-status">{{item.error || item.message}}</text></view>

    <view wx:if="{{item.state === 'queued' || item.state === 'running'}}" class="actions">
      <button size="mini" data-task-id="{{item.taskId}}" bindtap="skipImage">跳过此图</button>
    </view>
    <button wx:if="{{item.retryable}}" size="mini" class="secondary" data-task-id="{{item.taskId}}" bindtap="retryImage" disabled="{{importing}}">重试</button>
    <view wx:if="{{item.retained}}" class="hint">本图上次的成功草稿已保留，请核对后导入。</view>
    <view wx:if="{{item.uncertainCount}}" class="hint">另有内容待核对，未加入待导入列表。</view>
    <button wx:if="{{item.uncertainCount}}" size="mini" class="secondary" data-index="{{item.index - 1}}" bindtap="previewImage">核对原图</button>
  </view>
  <view wx:if="{{completed || drafts.length}}">
    <view class="heading board-title">待确认导入 · {{drafts.length}} 件</view>
    <view wx:if="{{mock}}" class="notice">模拟示例，与截图内容无关；确认导入也会保存到本机。</view>
    <view wx:for="{{draftGroups}}" wx:key="station" wx:for-item="group" class="card">
      <view class="section-title">{{group.station}}</view>
      <view wx:for="{{group.items}}" wx:key="id" class="parcel">
        <text class="pickup-code" user-select="{{true}}">{{item.code}}</text>
        <view wx:if="{{item.carrier}}" class="hint">{{item.carrier}}</view>
        <view class="hint">截图 {{item.sourceIndex + 1}} · {{item.needsReview ? '地点待确认' : '请核对原图'}}</view>
        <button size="mini" class="secondary" data-id="{{item.id}}" bindtap="editRecord" disabled="{{loading || importing}}">修改</button>
      </view>
    </view>
    <view wx:if="{{loading && drafts.length}}" class="hint">已完成的记录可先确认导入，其余图片会继续识别。</view>
    <button wx:if="{{drafts.length}}" class="primary" bindtap="confirmImport" disabled="{{importing || deleting || storageBlocked}}" loading="{{importing}}">确认导入</button>
  </view>
  <view wx:if="{{records.length}}">
    <view class="heading board-title">取件看板 · 待取 {{remaining}} 件</view>
    <view wx:for="{{groups}}" wx:key="station" wx:for-item="group" class="card">
      <view class="section-title">{{group.station}}</view>
      <view wx:for="{{group.items}}" wx:key="id" class="swipe-shell" data-id="{{item.id}}"
        bindtouchstart="touchStart" bindtouchmove="touchMove" bindtouchend="touchEnd" bindtouchcancel="touchCancel" catchtap="recordTap" bindlongpress="recordLongPress">
        <button wx:if="{{item.taken && openDeleteId === item.id}}" class="delete-button" size="mini" data-id="{{item.id}}" catchtap="deleteRecord"
          disabled="{{deleting || importing || storageBlocked}}"><text class="delete-label">删除</text></button>
        <view class="parcel swipe-content {{item.taken ? 'taken' : ''}} {{openDeleteId === item.id ? 'swipe-open' : ''}}">
          <text class="pickup-code" user-select="{{true}}">{{item.code}}</text>
          <view class="hint">{{item.carrier ? item.carrier + ' · ' : ''}}{{item.taken ? '已取' : '待取'}}</view>
          <view wx:if="{{item.taken}}" class="hint">左滑或长按可删除</view>
          <view class="actions">
            <button size="mini" class="secondary" data-id="{{item.id}}" catchtap="editRecord" disabled="{{loading || importing || deleting || storageBlocked}}">修改</button>
            <button size="mini" class="secondary" data-id="{{item.id}}" catchtap="toggleTaken" disabled="{{loading || importing || deleting || storageBlocked}}">{{item.taken ? '恢复待取' : '我已取件'}}</button>
          </view>
        </view>
      </view>
    </view>
  </view>
  <view wx:if="{{editing}}" class="card">
    <view class="section-title">核对并修改</view>
    <input value="{{editing.station}}" bindinput="editStation" placeholder="取件地点" maxlength="100" />
    <input value="{{editing.code}}" bindinput="editCode" placeholder="取件码" maxlength="32" />
    <view class="actions"><button size="mini" bindtap="cancelEdit">取消</button><button size="mini" class="primary" bindtap="saveEdit">保存修改</button></view>
  </view>
  <view wx:if="{{undoAvailable}}" class="undo-bar" catchtap="recordTap">
    <text>已删除 · 5 秒内可撤销</text><button class="undo-action" size="mini" catchtap="undoDelete" disabled="{{storageBlocked || importing || deleting}}">撤销</button>
  </view>
</view>
