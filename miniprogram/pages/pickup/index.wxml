<view class="pickup" bindtap="closeDelete">
  <view wx:if="{{storageError}}" class="error" role="alert">{{storageError}}</view>
  <view wx:if="{{error && activeTab !== 'import'}}" class="error" role="alert">{{error}}</view>
  <view wx:if="{{activeTab === 'home'}}">
    <view wx:if="{{importFeedback}}" class="import-feedback" role="status">{{importFeedback}}</view>
    <view class="page-header"><view><view class="eyebrow">校园取件助手</view><view class="heading">待取件 <text class="count">{{remaining}}</text> 件</view><view class="hint">{{locationCount}} 个取件地点{{unknownCount ? ' · ' + unknownCount + ' 件地点待确认' : ' · 按驿站找码'}}</view></view><button class="ui-button primary import-entry" data-tab="import" catchtap="switchTab">＋ 导入快递</button></view>
    <view wx:if="{{!remaining}}" class="empty"><view class="empty-symbol">✓</view><view class="section-title">暂无待取快递</view><view class="hint">有新的取件截图时，导入就能整理好。</view><button class="ui-button primary" data-tab="import" catchtap="switchTab">导入快递</button></view>
    <view wx:for="{{pendingGroups}}" wx:key="station" wx:for-item="group" class="card station-card">
      <view class="station-header" data-station="{{group.station}}" catchtap="toggleGroup" role="button" aria-label="{{group.collapsed ? '展开' : '收起'}}{{group.station}}"><view class="station-name {{group.station === '待确认地点' ? 'review' : ''}}">{{group.station}}</view><text class="station-count">{{group.items.length}} 件　{{group.collapsed ? '＋' : '−'}}</text></view>
      <view wx:if="{{!group.collapsed}}">
        <view wx:for="{{group.items}}" wx:key="id" class="parcel-row">
          <view class="parcel-main"><text class="pickup-code copy-code" data-id="{{item.id}}" catchtap="copyCode" role="button" aria-label="复制取件码 {{item.code}}">{{item.code}}</text><view class="record-meta"><text wx:if="{{item.carrier}}">{{item.carrier}} · </text><text class="text-action" data-id="{{item.id}}" catchtap="editRecord" role="button">{{group.station === '待确认地点' ? '补充地点' : '修改'}}</text></view></view>
          <button size="mini" class="ui-button {{(importing || deleting || storageBlocked) ? 'ui-disabled' : ''}} take-button" data-id="{{item.id}}" catchtap="toggleTaken" disabled="{{importing || deleting || storageBlocked}}">我已取件</button>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{activeTab === 'import'}}">
    <view class="heading">导入快递</view><view class="subtitle">选择截图，识别后核对并保存</view>
    <button class="ui-button {{(loading || choosing || importing) ? 'ui-disabled' : ''}} primary choose-button" bindtap="chooseImage" disabled="{{loading || choosing || importing}}" loading="{{choosing}}">{{images.length ? '重新选择截图' : '从相册选择截图'}}</button>
    <view class="hint centered">一次最多 9 张 · 单张不超过 5 MB · 选择后自动识别</view>
    <view wx:if="{{loading}}" class="progress-line"><text>{{progress}}</text><button size="mini" class="ui-button text-button" bindtap="cancelRecognition">停止本批</button></view>
    <view wx:if="{{error}}" class="error" role="alert">{{error}}</view>
    <view wx:if="{{drafts.length}}" class="draft-section">
      <view class="section-heading">核对结果 <text class="hint inline">{{drafts.length}} 件待导入</text></view>
      <view wx:if="{{mock}}" class="notice">模拟示例，与截图内容无关。</view>
      <view wx:for="{{draftGroups}}" wx:key="station" wx:for-item="group" class="card station-card">
        <view class="station-header"><view class="station-name {{group.station === '待确认地点' ? 'review' : ''}}">{{group.station}}</view><text class="station-count">{{group.items.length}} 件</text></view>
        <view wx:for="{{group.items}}" wx:key="id" class="parcel-row">
          <view class="parcel-main"><text class="pickup-code" user-select="{{true}}">{{item.code}}</text><view class="hint">截图 {{item.sourceIndex + 1}}{{item.carrier ? ' · ' + item.carrier : ''}}{{item.needsReview ? ' · 地点待确认' : ''}}</view></view>
          <button size="mini" class="ui-button {{(importing) ? 'ui-disabled' : ''}} secondary" data-id="{{item.id}}" bindtap="editRecord" disabled="{{importing}}">修改</button>
        </view>
      </view>
      <view wx:if="{{loading}}" class="hint">已完成的快递可先导入，其余图片继续识别。</view>
      <button class="ui-button {{(importing || deleting || storageBlocked) ? 'ui-disabled' : ''}} primary" bindtap="confirmImport" disabled="{{importing || deleting || storageBlocked}}" loading="{{importing}}">确认导入 {{drafts.length}} 件</button>
    </view>
    <view wx:if="{{results.length}}" class="section-heading small-heading">截图处理 · {{images.length}} 张</view>
    <view wx:for="{{results}}" wx:key="taskId" class="card image-result">
      <image class="result-thumbnail" src="{{images[item.index - 1]}}" mode="aspectFill" data-index="{{item.index - 1}}" bindtap="previewImage" />
      <view class="result-copy"><view class="result-label">截图 {{item.index}}</view><view class="result-status {{item.count ? 'success' : ''}}">{{item.error || item.message}}</view><view wx:if="{{item.retained}}" class="hint">上次成功结果已保留</view><view wx:if="{{item.uncertainCount}}" class="hint">有内容待核对，请点缩略图查看。</view></view>
      <button wx:if="{{item.state === 'queued' || item.state === 'running'}}" size="mini" class="ui-button text-button" data-task-id="{{item.taskId}}" bindtap="skipImage">跳过</button>
      <button wx:if="{{item.retryable}}" size="mini" class="ui-button {{(importing) ? 'ui-disabled' : ''}} secondary" data-task-id="{{item.taskId}}" bindtap="retryImage" disabled="{{importing}}">重试</button>
    </view>
    <view class="privacy">截图将交由腾讯云识别，请核对后导入。取件记录仅保存在本机，清理小程序数据会丢失记录。</view>
  </view>

  <view wx:if="{{activeTab === 'history'}}">
    <view class="heading">已取件记录</view><view class="subtitle">{{history.length}} 件已领取 · 左滑记录可删除</view>
    <view wx:if="{{!history.length}}" class="empty"><view class="empty-symbol">✓</view><view class="section-title">暂无已取件记录</view><view class="hint">领取后的快递会保存在这里。</view></view>
    <view class="card history-card" wx:if="{{history.length}}">
      <view wx:for="{{history}}" wx:key="id" class="swipe-shell" data-id="{{item.id}}" bindtouchstart="touchStart" bindtouchmove="touchMove" bindtouchend="touchEnd" bindtouchcancel="touchCancel" catchtap="recordTap">
        <view wx:if="{{openDeleteId === item.id}}" class="delete-button" role="button" aria-label="删除已取件记录" data-id="{{item.id}}" catchtap="deleteRecord"><text class="delete-label">删除</text></view>
        <view class="swipe-content {{openDeleteId === item.id ? 'swipe-open' : ''}}">
          <view class="history-top"><text class="pickup-code" user-select="{{true}}">{{item.code}}</text><text class="taken-badge">已取件</text></view>
          <view class="history-station">{{item.station}}</view>
          <view class="history-bottom"><text class="hint">{{item.carrier}}</text><button size="mini" class="ui-button {{(importing || deleting || storageBlocked) ? 'ui-disabled' : ''}} secondary" data-id="{{item.id}}" catchtap="toggleTaken" disabled="{{importing || deleting || storageBlocked}}">恢复待取</button></view>
        </view>
      </view>
    </view>
  </view>

  <view class="bottom-nav" catchtap="closeDelete">
    <button class="ui-button nav-item {{activeTab === 'home' ? 'nav-active' : ''}}" data-tab="home" catchtap="switchTab"><text class="nav-symbol">▤</text><text>待取件</text></button>
    <button class="ui-button nav-item {{activeTab === 'import' ? 'nav-active' : ''}}" data-tab="import" catchtap="switchTab"><text class="nav-symbol">＋</text><text>导入{{drafts.length ? ' · ' + drafts.length : loading ? ' · 识别中' : ''}}</text></button>
    <button class="ui-button nav-item {{activeTab === 'history' ? 'nav-active' : ''}}" data-tab="history" catchtap="switchTab"><text class="nav-symbol">✓</text><text>历史</text></button>
  </view>
  <view wx:if="{{undoAvailable}}" class="undo-bar" catchtap="recordTap"><text>{{undoMessage}} · 5 秒内可撤销</text><button class="ui-button {{(storageBlocked || importing || deleting) ? 'ui-disabled' : ''}} undo-action" size="mini" catchtap="undoDelete" disabled="{{storageBlocked || importing || deleting}}">撤销</button></view>
  <view wx:if="{{reviewOpen}}" class="modal-mask" catchtap="noop" catchtouchmove="noop">
    <view class="review-sheet" catchtap="noop">
      <view class="review-header"><view class="section-title">核对重复快递</view><view class="hint">仅补全空缺信息，保留原记录状态。确认后统一保存。</view></view>
      <scroll-view class="review-list" scroll-y="{{true}}">
        <view wx:for="{{reviewItems}}" wx:key="id" wx:for-item="entry" class="review-item">
          <view class="review-code">{{entry.code}}</view><view class="hint">本次地点：{{entry.station}}</view><view wx:if="{{entry.carrier}}" class="hint">本次公司：{{entry.carrier}}</view>
          <view class="review-reason">{{entry.reason}}</view>
          <view wx:for="{{entry.matches}}" wx:key="id" wx:for-item="match" class="match-info">
            <view class="hint">原记录（{{match.taken ? '已取件' : '待取件'}}）：{{match.code}}</view><view class="match-station">{{match.station}}{{match.carrier ? ' · ' + match.carrier : ''}}</view>
            <button wx:if="{{match.canUpdate}}" class="ui-button review-option {{entry.action === 'update' && entry.targetId === match.id ? 'option-selected' : ''}}" data-id="{{entry.id}}" data-action="update" data-target-id="{{match.id}}" catchtap="chooseImportAction">{{entry.action === 'update' && entry.targetId === match.id ? '✓ ' : ''}}更新此记录{{entry.recommended ? '（推荐）' : ''}}<text class="option-detail">补全{{match.additions}}</text></button>
          </view>
          <button class="ui-button review-option {{entry.action === 'skip' ? 'option-selected' : ''}}" data-id="{{entry.id}}" data-action="skip" catchtap="chooseImportAction">{{entry.action === 'skip' ? '✓ ' : ''}}保留原记录，跳过本次</button>
          <button wx:if="{{entry.allowNew}}" class="ui-button review-option {{entry.action === 'new' ? 'option-selected' : ''}}" data-id="{{entry.id}}" data-action="new" catchtap="chooseImportAction">{{entry.action === 'new' ? '✓ ' : ''}}确认是另一件包裹，新增</button>
          <view wx:else class="hint">运单号相同，不能重复新增。</view>
        </view>
      </scroll-view>
      <view class="review-footer"><view class="review-summary">{{reviewSummary}}</view><view class="actions"><button class="ui-button secondary" catchtap="cancelImportReview">返回核对</button><button class="ui-button primary" catchtap="finishImportReview">按以上选择导入</button></view></view>
    </view>
  </view>
  <view wx:if="{{editing}}" class="modal-mask" catchtap="cancelEdit" catchtouchmove="noop">
    <view class="edit-sheet" catchtap="noop">
      <view class="section-title">核对并修改</view>
      <text class="field-label">取件码</text><input class="field-input" value="{{editing.code}}" bindinput="editCode" placeholder="填写完整取件码" maxlength="32" adjust-position="{{true}}" />
      <text class="field-label">取件地点</text><textarea class="station-input" value="{{editing.station}}" bindinput="editStation" placeholder="填写驿站名称" maxlength="100" auto-height="{{true}}" adjust-position="{{true}}" />
      <text class="field-label">快递公司（选填）</text><input class="field-input" value="{{editing.carrier}}" bindinput="editCarrier" placeholder="如：中通快递" maxlength="40" adjust-position="{{true}}" />
      <view wx:if="{{editError}}" class="error">{{editError}}</view>
      <view class="actions"><button class="ui-button secondary" bindtap="cancelEdit">取消</button><button class="ui-button primary" bindtap="saveEdit">保存修改</button></view>
    </view>
  </view>
</view>
