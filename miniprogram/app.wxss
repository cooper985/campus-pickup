page {
  --page: #F7F5F0;
  --card: #FFFFFF;
  --text: #25231F;
  --muted: #827E77;
  /* Small secondary text needs stronger contrast on warm paper. */
  --secondary: #68645E;
  --accent: #C87356;
  --primary: #A94F38;
  --accent-ink: #9E4934;
  --surface: #F2E5DC;
  --line: #E7E2D9;
  --success: #819B83;
  --danger: #B84A44;
  --radius: 24rpx;
  --button-radius: 18rpx;
  --press-duration: 140ms;
  --motion-duration: 200ms;
  background: var(--page);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}
.container { display: flex; flex-direction: column; align-items: center; box-sizing: border-box; }
button { background: initial; }
button::after { border: none; }
